n:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\n\ndescribe('Task.create', () => {\n  test(\n    covers(\n      ['criterion:0001/titulo-invalido', 'invariant:Task/titulo-obrigatorio'],\n      'rejeita titulo vazio ou so com espacos com TASK_TITLE_REQUIRED',\n    ),\n    () => {\n      for (const title of ['', '   ']) {\n        try {\n          Task.create('t1', title);\n          throw new Error('Expected Task.create to throw');\n        } catch (error) {\n          expect(error).toBeInstanceOf(DomainError);\n          expect((error as DomainError).code).toBe('TASK_TITLE_REQUIRED');\n        }\n      }\n    },\n  );\n\n  test(\n    covers(['criterion:0001/criacao', 'method:Task.create'], 'cria tarefa pending, normaliza titulo e registra TaskCreated'),\n    () => {\n      const task = Task.create('t1', '  Minha tarefa  ');\n\n      expect(task.id).toBe('t1');\n      expect(task.title).toBe('Minha tarefa');\n      expect(task.status).toBe('pending');\n\n      const [event] = task.pullEvents();\n      expect(event).toBeInstanceOf(TaskCreated);\n      expect(event?.payload).toEqual({ taskId: 't1', title: 'Minha tarefa' });\n    },\n  );\n});\n","message":"Success. Updated the following files:\nA /tmp/agentic-eval-nokLAK/attempt-KDrNtK/workspace/app/test/entity-Task.test.ts"}}},"hookAdditionalContexts":[],"toolCallId":"call_gQmwI4lPlEuUvuA3rLr9l3UC\nctc_0a4e6f6f9b53d2d9016acaa7dfb9bc87d1b09591c772be0788","startedAtMs":"1791666143787","completedAtMs":"1791666146574"},"model_call_id":"c93969e9-fc3f-4562-9510-de7159bc79cf-20-iham","session_id":"afdc968c-cf10-41c6-8327-f65bb7523bc3","timestamp_ms":1791666145687}
