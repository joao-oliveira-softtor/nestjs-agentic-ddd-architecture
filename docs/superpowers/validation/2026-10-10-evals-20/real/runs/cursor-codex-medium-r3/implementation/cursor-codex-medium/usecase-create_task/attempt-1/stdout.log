ription: 'Cria, salva e publica uma tarefa pendente; id repetido falha com TASK_ALREADY_EXISTS.', whenToUse: 'Quando o usuário deseja criar uma tarefa.', whenNotToUse: 'Para concluir tarefa existente.', input: createTaskInput, output: createTaskOutput, uses: ['method:Task.create'], emits: [TaskCreated] })\nexport class CreateTask implements UseCase<CreateTaskInput, CreateTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CreateTaskInput, ctx: UseCaseContext): Promise<CreateTaskOutput> {\n    return notImplemented();\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n}\n","afterFullFileContent":"import { z } from 'zod';\nimport { DomainError, notImplemented, type UseCase, type UseCaseContext } from '@agentic-ddd/core';\nimport { AgentUseCase } from '@agentic-ddd/decorators';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\n\nexport const createTaskInput = z.object({ task_id: z.string().min(1), title: z.string().min(1) });\nexport const createTaskOutput = z.object({ task_id: z.string(), title: z.string(), status: z.literal('pending') });\nexport type CreateTaskInput = z.infer<typeof createTaskInput>;\nexport type CreateTaskOutput = z.infer<typeof createTaskOutput>;\n\n@AgentUseCase({ name: 'create_task', description: 'Cria, salva e publica uma tarefa pendente; id repetido falha com TASK_ALREADY_EXISTS.', whenToUse: 'Quando o usuário deseja criar uma tarefa.', whenNotToUse: 'Para concluir tarefa existente.', input: createTaskInput, output: createTaskOutput, uses: ['method:Task.create'], emits: [TaskCreated] })\nexport class CreateTask implements UseCase<CreateTaskInput, CreateTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CreateTaskInput, ctx: UseCaseContext): Promise<CreateTaskOutput> {\n    const existing = await this.tasks.findById(input.task_id); if (existing) throw new DomainError('TASK_ALREADY_EXISTS', 'Tarefa com este id ja existe.'); const task = Task.create(input.task_id, input.title); await this.tasks.save(task); await ctx.publish(task.pullEvents()); return { task_id: task.id, title: task.title, status: 'pending' };\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n}\n","message":"The file /tmp/agentic-eval-nokLAK/attempt-YAeT9Z/workspace/app/application/create-task.ts has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"call_4pUoozDSlK5upk7mFJADCy9q\nctc_0ddd352086319477016acaa8cde95c87d18ea60ada6a677a5d","startedAtMs":"1791666382006","completedAtMs":"1791666382547"},"model_call_id":"992bb323-d0b2-4551-a206-82c71d81c793-7-zq1d","session_id":"bde4ceac-055a-482b-9867-9d3324daa2f0","timestamp_ms":1791666381671}
