overs } from '@agentic-ddd/testing';\nimport { Task } from '../domain/task';\nimport { TaskCompleted } from '../domain/task.events';\n\ndescribe('Task.complete', () => {\n  test(\n    covers(\n      ['criterion:0001/conclusao', 'method:Task.complete'],\n      'registra TaskCompleted, muda para completed e rejeita repeticao com TASK_ALREADY_COMPLETED',\n    ),\n    () => {\n      const task = Task.create('t1', 'Minha tarefa');\n      task.pullEvents();\n\n      task.complete();\n\n      expect(task.status).toBe('completed');\n      const [event] = task.pullEvents();\n      expect(event).toBeInstanceOf(TaskCompleted);\n      expect(event?.payload).toEqual({ taskId: 't1' });\n\n      try {\n        task.complete();\n        throw new Error('Expected Task.complete to throw');\n      } catch (error) {\n        expect(error).toBeInstanceOf(DomainError);\n        expect((error as DomainError).code).toBe('TASK_ALREADY_COMPLETED');\n      }\n    },\n  );\n});\n","message":"The file /tmp/agentic-eval-nokLAK/attempt-8v5hfA/workspace/app/test/method-Task-complete.test.ts has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"call_Qo16sQ2QorShO4Uwl6MemXP3\nctc_06d7af56ae906a7e016acaa841976487d1b1a1ac74b8033ae0","startedAtMs":"1791666241686","completedAtMs":"1791666242530"},"model_call_id":"e99125c4-4392-49a1-921f-fe949145e872-8-oyim","session_id":"43349027-f7c2-499a-a4f4-a1c8c3ab17ea","timestamp_ms":1791666241638}
