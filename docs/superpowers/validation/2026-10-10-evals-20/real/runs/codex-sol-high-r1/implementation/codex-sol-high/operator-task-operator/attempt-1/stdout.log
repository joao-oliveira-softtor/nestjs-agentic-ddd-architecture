{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/usr/bin/zsh -lc 'cat app/operators/task.operator.ts app/infrastructure/in-memory-task.repository.ts app/application/create-task.ts app/application/complete-task.ts app/domain/task.ts app/domain/task.events.ts app/test/usecase-create_task.test.ts app/test/usecase-complete_task.test.ts tsconfig.json'","aggregated_output":"import { Operator } from '@agentic-ddd/decorators';\nimport { CreateTask } from '../application/create-task';\nimport { CompleteTask } from '../application/complete-task';\n\n@Operator({ name: 'task-operator', description: 'Cria e conclui tarefas conforme pedido do usuário.', instructions: 'Use as tools para criar e concluir tarefas. Identifique a tarefa pelo id e responda em português.', useCases: [CreateTask, CompleteTask] })\nexport class TaskOperator {}\nimport type { TaskRepository } from '../domain/task.repository';\nimport type { Task } from '../domain/task';\n\nexport class InMemoryTaskRepository implements TaskRepository {\n  readonly #tasks = new Map<string, Task>();\n  async findById(id: string): Promise<Task | null> { return this.#tasks.get(id) ?? null; }\n  async save(task: Task): Promise<void> { this.#tasks.set(task.id, task); }\n}\nimport { z } from 'zod';\nimport { DomainError, notImplemented, type UseCase, type UseCaseContext } from '@agentic-ddd/core';\nimport { AgentUseCase } from '@agentic-ddd/decorators';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\n\nexport const createTaskInput = z.object({ task_id: z.string().min(1), title: z.string().min(1) });\nexport const createTaskOutput = z.object({ task_id: z.string(), title: z.string(), status: z.literal('pending') });\nexport type CreateTaskInput = z.infer<typeof createTaskInput>;\nexport type CreateTaskOutput = z.infer<typeof createTaskOutput>;\n\n@AgentUseCase({ name: 'create_task', description: 'Cria, salva e publica uma tarefa pendente; id repetido falha com TASK_ALREADY_EXISTS.', whenToUse: 'Quando o usuário deseja criar uma tarefa.', whenNotToUse: 'Para concluir tarefa existente.', input: createTaskInput, output: createTaskOutput, uses: ['method:Task.create'], emits: [TaskCreated] })\nexport class CreateTask implements UseCase<CreateTaskInput, CreateTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CreateTaskInput, ctx: UseCaseContext): Promise<CreateTaskOutput> {\n    const existing = await this.tasks.findById(input.task_id);\n    if (existing) throw new DomainError('TASK_ALREADY_EXISTS', 'A tarefa já existe.');\n    const task = Task.create(input.task_id, input.title);\n    await this.tasks.save(task);\n    await ctx.publish(task.pullEvents());\n    return { task_id: task.id, title: task.title, status: 'pending' };\n\n\n\n\n\n\n\n\n  }\n}\nimport { z } from 'zod';\nimport { DomainError, notImplemented, type UseCase, type UseCaseContext } from '@agentic-ddd/core';\nimport { AgentUseCase } from '@agentic-ddd/decorators';\nimport { TaskCompleted } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\n\nexport const completeTaskInput = z.object({ task_id: z.string().min(1) });\nexport const completeTaskOutput = z.object({ task_id: z.string(), status: z.literal('completed') });\nexport type CompleteTaskInput = z.infer<typeof completeTaskInput>;\nexport type CompleteTaskOutput = z.infer<typeof completeTaskOutput>;\n\n@AgentUseCase({ name: 'complete_task', description: 'Carrega, conclui, salva e publica a tarefa; id ausente falha com TASK_NOT_FOUND.', whenToUse: 'Quando o usuário terminou uma tarefa.', whenNotToUse: 'Para criar uma nova tarefa.', input: completeTaskInput, output: completeTaskOutput, uses: ['method:Task.complete'], emits: [TaskCompleted] })\nexport class CompleteTask implements UseCase<CompleteTaskInput, CompleteTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CompleteTaskInput, ctx: UseCaseContext): Promise<CompleteTaskOutput> {\n    const task = await this.tasks.findById(input.task_id);\n    if (!task) throw new DomainError('TASK_NOT_FOUND', 'A tarefa não foi encontrada.');\n    task.complete();\n    await this.tasks.save(task);\n    await ctx.publish(task.pullEvents());\n    return { task_id: task.id, status: 'completed' };\n\n\n\n\n\n\n\n\n  }\n}\nimport { AggregateRoot, DomainError, notImplemented } from '@agentic-ddd/core';\nimport { AgentEntity, AgentMethod, Invariant } from '@agentic-ddd/decorators';\nimport { TaskCreated, TaskCompleted } from './task.events';\n\n@AgentEntity({ description: 'Tarefa com título e ciclo de vida pendente ou concluído.', states: ['pending', 'completed'] })\n@Invariant({ id: 'titulo-obrigatorio', text: 'Toda tarefa precisa de título não vazio.' })\nexport class Task extends AggregateRoot<string> {\n  #status: 'pending' | 'completed' = 'pending';\n  private constructor(id: string, readonly title: string) { super(id); }\n  get status(): 'pending' | 'completed' { return this.#status; }\n\n  @AgentMethod({ description: 'Cria uma tarefa pendente e remove espaços nas extremidades do título.', emits: [TaskCreated] })\n  static create(id: string, title: string): Task {\n    const normalizedTitle = title.trim();\n    if (!normalizedTitle) throw new DomainError('TASK_TITLE_REQUIRED', 'Toda tarefa precisa de título não vazio.');\n    const task = new Task(id, normalizedTitle);\n    task.record(new TaskCreated({ taskId: id, title: normalizedTitle }));\n    return task;\n\n\n\n\n\n\n\n\n\n  }\n\n  @AgentMethod({ description: 'Conclui uma tarefa pendente; repetição falha com TASK_ALREADY_COMPLETED.', transition: { from: ['pending'], to: 'completed' }, emits: [TaskCompleted] })\n  complete(): void {\n    if (this.#status === 'completed') throw new DomainError('TASK_ALREADY_COMPLETED', 'A tarefa já foi concluída.');\n    this.#status = 'completed';\n    this.record(new TaskCompleted({ taskId: this.id }));\n\n\n\n\n\n\n\n\n\n\n\n  }\n}\nimport { z } from 'zod';\nimport { DomainEvent } from '@agentic-ddd/core';\nimport { AgentEvent } from '@agentic-ddd/decorators';\n\n@AgentEvent({ description: 'Uma tarefa foi criada.', payload: z.object({ taskId: z.string(), title: z.string() }) })\nexport class TaskCreated extends DomainEvent<{ readonly taskId: string; readonly title: string }> {}\n\n@AgentEvent({ description: 'Uma tarefa foi concluída.', payload: z.object({ taskId: z.string() }) })\nexport class TaskCompleted extends DomainEvent<{ readonly taskId: string }> {}\nimport { expect, test } from 'bun:test';\nimport { DomainError, type UseCaseContext } from '@agentic-ddd/core';\nimport { covers, createTestContext } from '@agentic-ddd/testing';\nimport { CreateTask, createTaskOutput } from '../application/create-task';\nimport { TaskCreated } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\nimport { InMemoryTaskRepository } from '../infrastructure/in-memory-task.repository';\n\nfunction setup() {\n  const storage = new InMemoryTaskRepository();\n  const calls: string[] = [];\n  const repository: TaskRepository = {\n    async findById(id) {\n      calls.push(`load:${id}`);\n      return storage.findById(id);\n    },\n    async save(task) {\n      await storage.save(task);\n      calls.push(`save:${task.id}`);\n    },\n  };\n  const ctx = createTestContext({ correlationId: 'correlation-1', causationId: 'causation-1' });\n  return { storage, calls, repository, ctx };\n}\n\ntest(covers([\n  'usecase:create_task',\n  'criterion:0001/persistencia-criacao',\n], 'salva t1 pendente, publica TaskCreated e rejeita repetição com TASK_ALREADY_EXISTS'), async () => {\n  const fixture = setup();\n  const ctx: UseCaseContext = {\n    ...fixture.ctx,\n    async publish(events) {\n      expect(fixture.calls).toEqual(['load:t1', 'save:t1']);\n      const stored = await fixture.storage.findById('t1');\n      expect(stored?.title).toBe('Minha  tarefa');\n      expect(stored?.status).toBe('pending');\n      await fixture.ctx.publish(events);\n      fixture.calls.push('publish');\n    },\n  };\n  const useCase = new CreateTask(fixture.repository);\n  expect(await fixture.storage.findById('t1')).toBeNull();\n\n  const output = await useCase.execute({ task_id: 't1', title: ' \\tMinha  tarefa\\n ' }, ctx);\n\n  expect(output).toEqual({ task_id: 't1', title: 'Minha  tarefa', status: 'pending' });\n  expect(createTaskOutput.parse(output)).toEqual(output);\n  expect(fixture.calls).toEqual(['load:t1', 'save:t1', 'publish']);\n  expect(fixture.ctx.published).toHaveLength(1);\n  expect(fixture.ctx.published[0]).toBeInstanceOf(TaskCreated);\n  expect(fixture.ctx.published[0]?.payload).toEqual({ taskId: 't1', title: 'Minha  tarefa' });\n  expect(fixture.ctx.published[0]?.correlationId).toBe(ctx.correlationId);\n  expect(fixture.ctx.published[0]?.causationId).toBe(ctx.causationId);\n  const stored = await fixture.storage.findById('t1');\n  expect(stored?.pullEvents()).toEqual([]);\n\n  const repetition = useCase.execute({ task_id: 't1', title: 'Outro título' }, ctx);\n\n  await expect(repetition).rejects.toBeInstanceOf(DomainError);\n  await expect(repetition).rejects.toHaveProperty('code', 'TASK_ALREADY_EXISTS');\n  expect(fixture.calls).toEqual(['load:t1', 'save:t1', 'publish', 'load:t1']);\n  expect(await fixture.storage.findById('t1')).toBe(stored);\n  expect(stored?.title).toBe('Minha  tarefa');\n  expect(stored?.status).toBe('pending');\n  expect(fixture.ctx.published).toHaveLength(1);\n});\n\ntest(covers([\n  'usecase:create_task',\n], 'rejeita título composto apenas por espaços sem salvar ou publicar'), async () => {\n  const fixture = setup();\n  const execution = new CreateTask(fixture.repository).execute({ task_id: 't1', title: ' \\t\\n ' }, fixture.ctx);\n\n  await expect(execution).rejects.toBeInstanceOf(DomainError);\n  await expect(execution).rejects.toHaveProperty('code', 'TASK_TITLE_REQUIRED');\n  expect(fixture.calls).toEqual(['load:t1']);\n  expect(await fixture.storage.findById('t1')).toBeNull();\n  expect(fixture.ctx.published).toEqual([]);\n});\n\ntest(covers([\n  'usecase:create_task',\n], 'propaga falha ao salvar sem publicar TaskCreated'), async () => {\n  const fixture = setup();\n  const failure = new Error('Falha de persistência');\n  const repository: TaskRepository = {\n    findById: fixture.repository.findById,\n    async save(task) {\n      expect(task.id).toBe('t1');\n      expect(task.status).toBe('pending');\n      await Promise.resolve();\n      throw failure;\n    },\n  };\n\n  await expect(new CreateTask(repository).execute({ task_id: 't1', title: 'Tarefa' }, fixture.ctx)).rejects.toBe(failure);\n\n  expect(fixture.calls).toEqual(['load:t1']);\n  expect(await fixture.storage.findById('t1')).toBeNull();\n  expect(fixture.ctx.published).toEqual([]);\n});\nimport { expect, test } from 'bun:test';\nimport { DomainError, type UseCaseContext } from '@agentic-ddd/core';\nimport { covers, createTestContext } from '@agentic-ddd/testing';\nimport { CompleteTask } from '../application/complete-task';\nimport { Task } from '../domain/task';\nimport { TaskCompleted } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\nimport { InMemoryTaskRepository } from '../infrastructure/in-memory-task.repository';\n\nasync function setup() {\n  const task = Task.create('t1', 'Concluir tarefa');\n  task.pullEvents();\n  const storage = new InMemoryTaskRepository();\n  await storage.save(task);\n  const calls: string[] = [];\n  const savedStatuses: string[] = [];\n  const repository: TaskRepository = {\n    async findById(id) {\n      calls.push(`load:${id}`);\n      return storage.findById(id);\n    },\n    async save(aggregate) {\n      await storage.save(aggregate);\n      savedStatuses.push(aggregate.status);\n      calls.push(`save:${aggregate.id}`);\n    },\n  };\n  const ctx = createTestContext({ correlationId: 'correlation-1', causationId: 'causation-1' });\n  return { task, storage, calls, savedStatuses, repository, ctx };\n}\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'carrega t1, salva completed e aguarda a publicação de TaskCompleted pelo contexto'), async () => {\n  const fixture = await setup();\n  const ctx: UseCaseContext = {\n    ...fixture.ctx,\n    async publish(events) {\n      expect(fixture.savedStatuses).toEqual(['completed']);\n      expect((await fixture.storage.findById('t1'))?.status).toBe('completed');\n      expect(events).toHaveLength(1);\n      expect(events[0]?.correlationId).toBeNull();\n      expect(events[0]?.causationId).toBeNull();\n      await fixture.ctx.publish(events);\n      fixture.calls.push('publish');\n    },\n  };\n\n  const output = await new CompleteTask(fixture.repository).execute({ task_id: 't1' }, ctx);\n\n  expect(output).toEqual({ task_id: 't1', status: 'completed' });\n  expect(fixture.calls).toEqual(['load:t1', 'save:t1', 'publish']);\n  expect(fixture.ctx.published).toHaveLength(1);\n  expect(fixture.ctx.published[0]).toBeInstanceOf(TaskCompleted);\n  expect(fixture.ctx.published[0]?.payload).toEqual({ taskId: 't1' });\n  expect(fixture.ctx.published[0]?.correlationId).toBe(ctx.correlationId);\n  expect(fixture.ctx.published[0]?.causationId).toBe(ctx.causationId);\n  expect(fixture.task.pullEvents()).toEqual([]);\n});\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'rejeita id inexistente com TASK_NOT_FOUND sem salvar ou publicar'), async () => {\n  const fixture = await setup();\n  const execution = new CompleteTask(fixture.repository).execute({ task_id: 'missing' }, fixture.ctx);\n\n  await expect(execution).rejects.toBeInstanceOf(DomainError);\n  await expect(execution).rejects.toHaveProperty('code', 'TASK_NOT_FOUND');\n  expect(fixture.calls).toEqual(['load:missing']);\n  expect(fixture.savedStatuses).toEqual([]);\n  expect(fixture.ctx.published).toEqual([]);\n  expect(fixture.task.status).toBe('pending');\n});\n\ntest(covers([\n  'usecase:complete_task',\n], 'rejeita segunda conclusão com TASK_ALREADY_COMPLETED sem nova gravação ou publicação'), async () => {\n  const fixture = await setup();\n  const useCase = new CompleteTask(fixture.repository);\n  await useCase.execute({ task_id: 't1' }, fixture.ctx);\n  fixture.calls.length = 0;\n\n  const execution = useCase.execute({ task_id: 't1' }, fixture.ctx);\n\n  await expect(execution).rejects.toBeInstanceOf(DomainError);\n  await expect(execution).rejects.toHaveProperty('code', 'TASK_ALREADY_COMPLETED');\n  expect(fixture.calls).toEqual(['load:t1']);\n  expect(fixture.savedStatuses).toEqual(['completed']);\n  expect(fixture.ctx.published).toHaveLength(1);\n  expect(fixture.task.status).toBe('completed');\n  expect(fixture.task.pullEvents()).toEqual([]);\n});\n\ntest(covers([\n  'usecase:complete_task',\n], 'propaga falha ao salvar sem publicar ou retirar os eventos pendentes'), async () => {\n  const fixture = await setup();\n  const failure = new Error('Falha de persistência');\n  const repository: TaskRepository = {\n    findById: fixture.repository.findById,\n    async save() {\n      await Promise.resolve();\n      throw failure;\n    },\n  };\n\n  await expect(new CompleteTask(repository).execute({ task_id: 't1' }, fixture.ctx)).rejects.toBe(failure);\n\n  expect(fixture.calls).toEqual(['load:t1']);\n  expect(fixture.ctx.published).toEqual([]);\n  expect(fixture.task.pullEvents()[0]).toBeInstanceOf(TaskCompleted);\n});\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"preserve\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"experimentalDecorators\": true,\n    \"emitDecoratorMetadata\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"noEmit\": true,\n    \"types\": [\n      \"bun\"\n    ],\n    \"paths\": {\n      \"@agentic-ddd/*\": [\n        \"/tmp/agentic-eval-HipMo7/framework/src/*/index.ts\"\n      ],\n      \"zod\": [\n        \"/tmp/agentic-eval-HipMo7/framework/node_modules/zod\"\n      ]\n    }\n  },\n  \"include\": [\n    \"app/**/*.ts\",\n    \"agentic.config.ts\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
