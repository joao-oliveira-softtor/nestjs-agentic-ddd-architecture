{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/zsh -lc 'cat app/domain/task.repository.ts app/infrastructure/in-memory-task.repository.ts app/domain/task.events.ts app/test/entity-Task.test.ts app/test/method-Task-complete.test.ts tsconfig.json'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/zsh -lc 'cat app/domain/task.repository.ts app/infrastructure/in-memory-task.repository.ts app/domain/task.events.ts app/test/entity-Task.test.ts app/test/method-Task-complete.test.ts tsconfig.json'","aggregated_output":"import type { Repository } from '@agentic-ddd/core';\nimport type { Task } from './task';\nexport type TaskRepository = Repository<Task, string>;\nimport type { TaskRepository } from '../domain/task.repository';\nimport type { Task } from '../domain/task';\n\nexport class InMemoryTaskRepository implements TaskRepository {\n  readonly #tasks = new Map<string, Task>();\n  async findById(id: string): Promise<Task | null> { return this.#tasks.get(id) ?? null; }\n  async save(task: Task): Promise<void> { this.#tasks.set(task.id, task); }\n}\nimport { z } from 'zod';\nimport { DomainEvent } from '@agentic-ddd/core';\nimport { AgentEvent } from '@agentic-ddd/decorators';\n\n@AgentEvent({ description: 'Uma tarefa foi criada.', payload: z.object({ taskId: z.string(), title: z.string() }) })\nexport class TaskCreated extends DomainEvent<{ readonly taskId: string; readonly title: string }> {}\n\n@AgentEvent({ description: 'Uma tarefa foi concluída.', payload: z.object({ taskId: z.string() }) })\nexport class TaskCompleted extends DomainEvent<{ readonly taskId: string }> {}\nimport { expect, test } from 'bun:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\n\ntest(covers([\n  'invariant:Task/titulo-obrigatorio',\n  'method:Task.create',\n  'criterion:0001/titulo-invalido',\n], 'rejeita títulos vazios ou compostos apenas por espaços com TASK_TITLE_REQUIRED'), () => {\n  for (const title of ['', '   ', '\\t\\n ']) {\n    let error: unknown;\n    try {\n      Task.create('t1', title);\n    } catch (caught) {\n      error = caught;\n    }\n    expect(error).toBeInstanceOf(DomainError);\n    expect(error).toHaveProperty('code', 'TASK_TITLE_REQUIRED');\n  }\n});\n\ntest(covers([\n  'method:Task.create',\n  'criterion:0001/criacao',\n], 'cria tarefa pendente, normaliza o título e registra TaskCreated'), () => {\n  const task = Task.create('t1', ' \\tMinha  tarefa\\n ');\n\n  expect(task.id).toBe('t1');\n  expect(task.title).toBe('Minha  tarefa');\n  expect(task.status).toBe('pending');\n\n  const events = task.pullEvents();\n  expect(events).toHaveLength(1);\n  expect(events[0]).toBeInstanceOf(TaskCreated);\n  expect(events[0]?.name).toBe('TaskCreated');\n  expect(events[0]?.payload).toEqual({ taskId: 't1', title: 'Minha  tarefa' });\n  expect(task.pullEvents()).toEqual([]);\n});\nimport { expect, test } from 'bun:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { Task } from '../domain/task';\nimport { TaskCompleted } from '../domain/task.events';\n\ntest(covers([\n  'method:Task.complete',\n  'criterion:0001/conclusao',\n], 'conclui tarefa pendente, registra TaskCompleted e rejeita repetição com TASK_ALREADY_COMPLETED'), () => {\n  const task = Task.create('task-complete-1', 'Concluir tarefa');\n  task.pullEvents();\n  expect(task.status).toBe('pending');\n\n  task.complete();\n\n  expect(task.status).toBe('completed');\n  const events = task.pullEvents();\n  expect(events).toHaveLength(1);\n  expect(events[0]).toBeInstanceOf(TaskCompleted);\n  expect(events[0]?.name).toBe('TaskCompleted');\n  expect(events[0]?.payload).toEqual({ taskId: 'task-complete-1' });\n\n  let error: unknown;\n  try {\n    task.complete();\n  } catch (caught) {\n    error = caught;\n  }\n\n  expect(error).toBeInstanceOf(DomainError);\n  expect(error).toHaveProperty('code', 'TASK_ALREADY_COMPLETED');\n  expect(task.status).toBe('completed');\n  expect(task.pullEvents()).toEqual([]);\n});\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"preserve\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"experimentalDecorators\": true,\n    \"emitDecoratorMetadata\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"noEmit\": true,\n    \"types\": [\n      \"bun\"\n    ],\n    \"paths\": {\n      \"@agentic-ddd/*\": [\n        \"/tmp/agentic-eval-HipMo7/framework/src/*/index.ts\"\n      ],\n      \"zod\": [\n        \"/tmp/agentic-eval-HipMo7/framework/node_modules/zod\"\n      ]\n    }\n  },\n  \"include\": [\n    \"app/**/*.ts\",\n    \"agentic.config.ts\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
