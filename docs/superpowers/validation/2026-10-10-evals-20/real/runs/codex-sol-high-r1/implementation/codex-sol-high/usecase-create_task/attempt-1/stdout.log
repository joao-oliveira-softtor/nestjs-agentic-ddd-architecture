{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/zsh -lc 'cat AGENTS.md app/application/complete-task.ts app/domain/task.repository.ts app/domain/task.events.ts app/infrastructure/in-memory-task.repository.ts app/test/usecase-complete_task.test.ts app/test/entity-Task.test.ts tsconfig.json'","aggregated_output":"# Tutorial tasks\n\nUse a skill autoral agentic-ddd instalada e a skill gerada tasks-dev após compile. Executor altera somente corpo atribuído e testes; preserve imports, contratos, propostas e gerados.\n\n<!-- agentic-ddd:begin -->\n<!-- GERADO por agentic-ddd compile — não edite este bloco; o texto fora dele é seu. -->\n\n## Domínio (agentic-ddd)\n\n| Módulo | Código | Skill de dev |\n|---|---|---|\n| tasks | `app` | `.agents/skills/tasks-dev/SKILL.md` |\n\n| Operator | Skill de runtime |\n|---|---|\n| task-operator | `.agentic/runtime/task-operator/SKILL.md` |\n\n### Convenções\n\n- Entidades, métodos, eventos, use-cases e operators são declarados com `@AgentEntity`, `@AgentMethod`, `@AgentEvent`, `@AgentUseCase` e `@Operator` de `@agentic-ddd/decorators`; cada regra de negócio é um `@Invariant({ id, text })` com ID estável.\n- Onde criar: `<caminho do módulo>/domain` (entidades, eventos, ports), `<caminho do módulo>/application` (use-cases, sempre com `uses`), `<caminho do módulo>/operators` (operators). A skill de dev do módulo tem os caminhos exatos.\n- Todo método público de entidade tem `@AgentMethod`; métodos auxiliares usam `#privado`.\n- Corpo declarado e ainda não implementado usa `notImplemented()` de `@agentic-ddd/core`.\n- Coordenação: consulte `bun run agentic status` ou `next` (ondas); execute cada item a partir de `bun run agentic packet <item>` e valide com `bun run agentic verify --item <item> --spec-hash <hash>`. `status --static` lê declarações de teste sem executá-las e nunca certifica `done`.\n- O sinal de esqueleto reconhece só a chamada literal `notImplemented()`; corpo vazio conta como implementado. Estado é calculado sob demanda e não entra nos arquivos gerados.\n- Testes declaram o que cobrem com `covers([...ids], título)` de `@agentic-ddd/testing`.\n- Mudança de regra de negócio: escreva antes a proposta em `changes/NNNN-<slug>/proposal.md` (delta, critérios de aceite e `## Motivo`), implemente e rode `bun run agentic compile`; para mudança já feita no código, `bun run agentic compile --draft-change <slug>` gera o rascunho.\n- Uma tarefa só está concluída quando `bun run agentic verify <NNNN>` retorna `done` ou `needs-human`.\n- Gerados (não edite): `.agents/skills`, `.agentic/runtime`, os espelhos de skills e este bloco. Altere o código decorado e rode `bun run agentic compile`; o CI roda `bun run agentic compile --check`.\n<!-- agentic-ddd:end -->\nimport { z } from 'zod';\nimport { DomainError, notImplemented, type UseCase, type UseCaseContext } from '@agentic-ddd/core';\nimport { AgentUseCase } from '@agentic-ddd/decorators';\nimport { TaskCompleted } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\n\nexport const completeTaskInput = z.object({ task_id: z.string().min(1) });\nexport const completeTaskOutput = z.object({ task_id: z.string(), status: z.literal('completed') });\nexport type CompleteTaskInput = z.infer<typeof completeTaskInput>;\nexport type CompleteTaskOutput = z.infer<typeof completeTaskOutput>;\n\n@AgentUseCase({ name: 'complete_task', description: 'Carrega, conclui, salva e publica a tarefa; id ausente falha com TASK_NOT_FOUND.', whenToUse: 'Quando o usuário terminou uma tarefa.', whenNotToUse: 'Para criar uma nova tarefa.', input: completeTaskInput, output: completeTaskOutput, uses: ['method:Task.complete'], emits: [TaskCompleted] })\nexport class CompleteTask implements UseCase<CompleteTaskInput, CompleteTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CompleteTaskInput, ctx: UseCaseContext): Promise<CompleteTaskOutput> {\n    const task = await this.tasks.findById(input.task_id);\n    if (!task) throw new DomainError('TASK_NOT_FOUND', 'A tarefa não foi encontrada.');\n    task.complete();\n    await this.tasks.save(task);\n    await ctx.publish(task.pullEvents());\n    return { task_id: task.id, status: 'completed' };\n\n\n\n\n\n\n\n\n  }\n}\nimport type { Repository } from '@agentic-ddd/core';\nimport type { Task } from './task';\nexport type TaskRepository = Repository<Task, string>;\nimport { z } from 'zod';\nimport { DomainEvent } from '@agentic-ddd/core';\nimport { AgentEvent } from '@agentic-ddd/decorators';\n\n@AgentEvent({ description: 'Uma tarefa foi criada.', payload: z.object({ taskId: z.string(), title: z.string() }) })\nexport class TaskCreated extends DomainEvent<{ readonly taskId: string; readonly title: string }> {}\n\n@AgentEvent({ description: 'Uma tarefa foi concluída.', payload: z.object({ taskId: z.string() }) })\nexport class TaskCompleted extends DomainEvent<{ readonly taskId: string }> {}\nimport type { TaskRepository } from '../domain/task.repository';\nimport type { Task } from '../domain/task';\n\nexport class InMemoryTaskRepository implements TaskRepository {\n  readonly #tasks = new Map<string, Task>();\n  async findById(id: string): Promise<Task | null> { return this.#tasks.get(id) ?? null; }\n  async save(task: Task): Promise<void> { this.#tasks.set(task.id, task); }\n}\nimport { expect, test } from 'bun:test';\nimport { DomainError, type UseCaseContext } from '@agentic-ddd/core';\nimport { covers, createTestContext } from '@agentic-ddd/testing';\nimport { CompleteTask } from '../application/complete-task';\nimport { Task } from '../domain/task';\nimport { TaskCompleted } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\nimport { InMemoryTaskRepository } from '../infrastructure/in-memory-task.repository';\n\nasync function setup() {\n  const task = Task.create('t1', 'Concluir tarefa');\n  task.pullEvents();\n  const storage = new InMemoryTaskRepository();\n  await storage.save(task);\n  const calls: string[] = [];\n  const savedStatuses: string[] = [];\n  const repository: TaskRepository = {\n    async findById(id) {\n      calls.push(`load:${id}`);\n      return storage.findById(id);\n    },\n    async save(aggregate) {\n      await storage.save(aggregate);\n      savedStatuses.push(aggregate.status);\n      calls.push(`save:${aggregate.id}`);\n    },\n  };\n  const ctx = createTestContext({ correlationId: 'correlation-1', causationId: 'causation-1' });\n  return { task, storage, calls, savedStatuses, repository, ctx };\n}\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'carrega t1, salva completed e aguarda a publicação de TaskCompleted pelo contexto'), async () => {\n  const fixture = await setup();\n  const ctx: UseCaseContext = {\n    ...fixture.ctx,\n    async publish(events) {\n      expect(fixture.savedStatuses).toEqual(['completed']);\n      expect((await fixture.storage.findById('t1'))?.status).toBe('completed');\n      expect(events).toHaveLength(1);\n      expect(events[0]?.correlationId).toBeNull();\n      expect(events[0]?.causationId).toBeNull();\n      await fixture.ctx.publish(events);\n      fixture.calls.push('publish');\n    },\n  };\n\n  const output = await new CompleteTask(fixture.repository).execute({ task_id: 't1' }, ctx);\n\n  expect(output).toEqual({ task_id: 't1', status: 'completed' });\n  expect(fixture.calls).toEqual(['load:t1', 'save:t1', 'publish']);\n  expect(fixture.ctx.published).toHaveLength(1);\n  expect(fixture.ctx.published[0]).toBeInstanceOf(TaskCompleted);\n  expect(fixture.ctx.published[0]?.payload).toEqual({ taskId: 't1' });\n  expect(fixture.ctx.published[0]?.correlationId).toBe(ctx.correlationId);\n  expect(fixture.ctx.published[0]?.causationId).toBe(ctx.causationId);\n  expect(fixture.task.pullEvents()).toEqual([]);\n});\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'rejeita id inexistente com TASK_NOT_FOUND sem salvar ou publicar'), async () => {\n  const fixture = await setup();\n  const execution = new CompleteTask(fixture.repository).execute({ task_id: 'missing' }, fixture.ctx);\n\n  await expect(execution).rejects.toBeInstanceOf(DomainError);\n  await expect(execution).rejects.toHaveProperty('code', 'TASK_NOT_FOUND');\n  expect(fixture.calls).toEqual(['load:missing']);\n  expect(fixture.savedStatuses).toEqual([]);\n  expect(fixture.ctx.published).toEqual([]);\n  expect(fixture.task.status).toBe('pending');\n});\n\ntest(covers([\n  'usecase:complete_task',\n], 'rejeita segunda conclusão com TASK_ALREADY_COMPLETED sem nova gravação ou publicação'), async () => {\n  const fixture = await setup();\n  const useCase = new CompleteTask(fixture.repository);\n  await useCase.execute({ task_id: 't1' }, fixture.ctx);\n  fixture.calls.length = 0;\n\n  const execution = useCase.execute({ task_id: 't1' }, fixture.ctx);\n\n  await expect(execution).rejects.toBeInstanceOf(DomainError);\n  await expect(execution).rejects.toHaveProperty('code', 'TASK_ALREADY_COMPLETED');\n  expect(fixture.calls).toEqual(['load:t1']);\n  expect(fixture.savedStatuses).toEqual(['completed']);\n  expect(fixture.ctx.published).toHaveLength(1);\n  expect(fixture.task.status).toBe('completed');\n  expect(fixture.task.pullEvents()).toEqual([]);\n});\n\ntest(covers([\n  'usecase:complete_task',\n], 'propaga falha ao salvar sem publicar ou retirar os eventos pendentes'), async () => {\n  const fixture = await setup();\n  const failure = new Error('Falha de persistência');\n  const repository: TaskRepository = {\n    findById: fixture.repository.findById,\n    async save() {\n      await Promise.resolve();\n      throw failure;\n    },\n  };\n\n  await expect(new CompleteTask(repository).execute({ task_id: 't1' }, fixture.ctx)).rejects.toBe(failure);\n\n  expect(fixture.calls).toEqual(['load:t1']);\n  expect(fixture.ctx.published).toEqual([]);\n  expect(fixture.task.pullEvents()[0]).toBeInstanceOf(TaskCompleted);\n});\nimport { expect, test } from 'bun:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\n\ntest(covers([\n  'invariant:Task/titulo-obrigatorio',\n  'method:Task.create',\n  'criterion:0001/titulo-invalido',\n], 'rejeita títulos vazios ou compostos apenas por espaços com TASK_TITLE_REQUIRED'), () => {\n  for (const title of ['', '   ', '\\t\\n ']) {\n    let error: unknown;\n    try {\n      Task.create('t1', title);\n    } catch (caught) {\n      error = caught;\n    }\n    expect(error).toBeInstanceOf(DomainError);\n    expect(error).toHaveProperty('code', 'TASK_TITLE_REQUIRED');\n  }\n});\n\ntest(covers([\n  'method:Task.create',\n  'criterion:0001/criacao',\n], 'cria tarefa pendente, normaliza o título e registra TaskCreated'), () => {\n  const task = Task.create('t1', ' \\tMinha  tarefa\\n ');\n\n  expect(task.id).toBe('t1');\n  expect(task.title).toBe('Minha  tarefa');\n  expect(task.status).toBe('pending');\n\n  const events = task.pullEvents();\n  expect(events).toHaveLength(1);\n  expect(events[0]).toBeInstanceOf(TaskCreated);\n  expect(events[0]?.name).toBe('TaskCreated');\n  expect(events[0]?.payload).toEqual({ taskId: 't1', title: 'Minha  tarefa' });\n  expect(task.pullEvents()).toEqual([]);\n});\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"preserve\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"experimentalDecorators\": true,\n    \"emitDecoratorMetadata\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"noEmit\": true,\n    \"types\": [\n      \"bun\"\n    ],\n    \"paths\": {\n      \"@agentic-ddd/*\": [\n        \"/tmp/agentic-eval-HipMo7/framework/src/*/index.ts\"\n      ],\n      \"zod\": [\n        \"/tmp/agentic-eval-HipMo7/framework/node_modules/zod\"\n      ]\n    }\n  },\n  \"include\": [\n    \"app/**/*.ts\",\n    \"agentic.config.ts\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
