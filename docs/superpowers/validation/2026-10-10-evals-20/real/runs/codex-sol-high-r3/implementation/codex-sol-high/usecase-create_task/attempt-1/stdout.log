{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/zsh -lc 'cat app/application/complete-task.ts app/domain/task.repository.ts app/infrastructure/in-memory-task.repository.ts app/test/usecase-complete_task.test.ts app/test/entity-Task.test.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/usr/bin/zsh -lc 'cat app/application/complete-task.ts app/domain/task.repository.ts app/infrastructure/in-memory-task.repository.ts app/test/usecase-complete_task.test.ts app/test/entity-Task.test.ts'","aggregated_output":"import { z } from 'zod';\nimport { DomainError, notImplemented, type UseCase, type UseCaseContext } from '@agentic-ddd/core';\nimport { AgentUseCase } from '@agentic-ddd/decorators';\nimport { TaskCompleted } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\n\nexport const completeTaskInput = z.object({ task_id: z.string().min(1) });\nexport const completeTaskOutput = z.object({ task_id: z.string(), status: z.literal('completed') });\nexport type CompleteTaskInput = z.infer<typeof completeTaskInput>;\nexport type CompleteTaskOutput = z.infer<typeof completeTaskOutput>;\n\n@AgentUseCase({ name: 'complete_task', description: 'Carrega, conclui, salva e publica a tarefa; id ausente falha com TASK_NOT_FOUND.', whenToUse: 'Quando o usuário terminou uma tarefa.', whenNotToUse: 'Para criar uma nova tarefa.', input: completeTaskInput, output: completeTaskOutput, uses: ['method:Task.complete'], emits: [TaskCompleted] })\nexport class CompleteTask implements UseCase<CompleteTaskInput, CompleteTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CompleteTaskInput, ctx: UseCaseContext): Promise<CompleteTaskOutput> {\n    const task = await this.tasks.findById(input.task_id);\n    if (!task) {\n      throw new DomainError('TASK_NOT_FOUND', 'A tarefa não foi encontrada.');\n    }\n    task.complete();\n    await this.tasks.save(task);\n    await ctx.publish(task.pullEvents());\n    return { task_id: task.id, status: 'completed' };\n\n\n\n\n\n\n  }\n}\nimport type { Repository } from '@agentic-ddd/core';\nimport type { Task } from './task';\nexport type TaskRepository = Repository<Task, string>;\nimport type { TaskRepository } from '../domain/task.repository';\nimport type { Task } from '../domain/task';\n\nexport class InMemoryTaskRepository implements TaskRepository {\n  readonly #tasks = new Map<string, Task>();\n  async findById(id: string): Promise<Task | null> { return this.#tasks.get(id) ?? null; }\n  async save(task: Task): Promise<void> { this.#tasks.set(task.id, task); }\n}\nimport { expect, mock, test } from 'bun:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers, createTestContext } from '@agentic-ddd/testing';\nimport { CompleteTask } from '../application/complete-task';\nimport { Task } from '../domain/task';\nimport { TaskCompleted } from '../domain/task.events';\nimport { InMemoryTaskRepository } from '../infrastructure/in-memory-task.repository';\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'carrega t1, salva completed antes de publicar TaskCompleted e retorna o contrato'), async () => {\n  const persisted = new InMemoryTaskRepository();\n  const task = Task.create('t1', 'Concluir tarefa');\n  task.pullEvents();\n  await persisted.save(task);\n  const operations: string[] = [];\n  const repository = {\n    async findById(id: string) {\n      operations.push(`load:${id}`);\n      return persisted.findById(id);\n    },\n    async save(value: Task) {\n      await Promise.resolve();\n      await persisted.save(value);\n      operations.push(`save:${value.status}`);\n    },\n  };\n  const context = createTestContext();\n  const output = await new CompleteTask(repository).execute({ task_id: 't1' }, {\n    ...context,\n    async publish(events) {\n      operations.push('publish');\n      await context.publish(events);\n    },\n  });\n\n  expect(output).toEqual({ task_id: 't1', status: 'completed' });\n  expect(operations).toEqual(['load:t1', 'save:completed', 'publish']);\n  expect((await persisted.findById('t1'))?.status).toBe('completed');\n  expect(context.published).toHaveLength(1);\n  expect(context.published[0]).toBeInstanceOf(TaskCompleted);\n  expect(context.published[0]!.payload).toEqual({ taskId: 't1' });\n  expect(task.pullEvents()).toEqual([]);\n});\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'rejeita id ausente com TASK_NOT_FOUND sem salvar ou publicar'), async () => {\n  const repository = {\n    findById: mock(async (_id: string): Promise<Task | null> => null),\n    save: mock(async (_task: Task) => {}),\n  };\n  const context = createTestContext();\n  const publish = mock(context.publish);\n  const execution = new CompleteTask(repository).execute({ task_id: 'inexistente' }, {\n    ...context, publish,\n  });\n\n  await expect(execution).rejects.toBeInstanceOf(DomainError);\n  await expect(execution).rejects.toMatchObject({ code: 'TASK_NOT_FOUND' });\n  expect(repository.findById).toHaveBeenCalledWith('inexistente');\n  expect(repository.save).not.toHaveBeenCalled();\n  expect(publish).not.toHaveBeenCalled();\n  expect(context.published).toEqual([]);\n});\n\ntest(covers([\n  'usecase:complete_task',\n], 'propaga TASK_ALREADY_COMPLETED sem salvar ou publicar novamente'), async () => {\n  const task = Task.create('t1', 'Concluir tarefa');\n  task.complete();\n  task.pullEvents();\n  const repository = {\n    findById: mock(async (_id: string) => task),\n    save: mock(async (_task: Task) => {}),\n  };\n  const context = createTestContext();\n  const publish = mock(context.publish);\n  const execution = new CompleteTask(repository).execute({ task_id: 't1' }, {\n    ...context, publish,\n  });\n\n  await expect(execution).rejects.toBeInstanceOf(DomainError);\n  await expect(execution).rejects.toMatchObject({ code: 'TASK_ALREADY_COMPLETED' });\n  expect(task.status).toBe('completed');\n  expect(repository.save).not.toHaveBeenCalled();\n  expect(publish).not.toHaveBeenCalled();\n  expect(task.pullEvents()).toEqual([]);\n});\n\ntest(covers([\n  'usecase:complete_task',\n], 'aguarda gravação e propaga sua falha sem publicar eventos'), async () => {\n  const task = Task.create('t1', 'Concluir tarefa');\n  task.pullEvents();\n  const failure = new Error('Falha ao salvar');\n  const repository = {\n    async findById(_id: string) { return task; },\n    async save(_task: Task) {\n      await Promise.resolve();\n      throw failure;\n    },\n  };\n  const context = createTestContext();\n  const publish = mock(context.publish);\n\n  await expect(new CompleteTask(repository).execute({ task_id: 't1' }, {\n    ...context, publish,\n  })).rejects.toBe(failure);\n  expect(publish).not.toHaveBeenCalled();\n  expect(context.published).toEqual([]);\n});\nimport { expect, test } from 'bun:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\n\nfor (const title of ['', '   ', '\\t\\n\\r ']) {\n  test(covers([\n    'invariant:Task/titulo-obrigatorio',\n    'method:Task.create',\n    'criterion:0001/titulo-invalido',\n  ], `rejeita título vazio após normalização: ${JSON.stringify(title)}`), () => {\n    let failure: unknown;\n    try {\n      Task.create('t1', title);\n    } catch (error) {\n      failure = error;\n    }\n    expect(failure).toBeInstanceOf(DomainError);\n    expect((failure as DomainError).code).toBe('TASK_TITLE_REQUIRED');\n  });\n}\n\ntest(covers([\n  'invariant:Task/titulo-obrigatorio',\n  'method:Task.create',\n  'criterion:0001/criacao',\n], 'cria tarefa pendente, normaliza título e registra TaskCreated'), () => {\n  const task = Task.create('t1', ' \\tComprar  pão\\n ');\n\n  expect(task.id).toBe('t1');\n  expect(task.title).toBe('Comprar  pão');\n  expect(task.status).toBe('pending');\n\n  const events = task.pullEvents();\n  expect(events).toHaveLength(1);\n  expect(events[0]).toBeInstanceOf(TaskCreated);\n  expect(events[0]!.name).toBe('TaskCreated');\n  expect(events[0]!.payload).toEqual({ taskId: 't1', title: 'Comprar  pão' });\n  expect(task.pullEvents()).toEqual([]);\n});\n","exit_code":0,"status":"completed"}}
