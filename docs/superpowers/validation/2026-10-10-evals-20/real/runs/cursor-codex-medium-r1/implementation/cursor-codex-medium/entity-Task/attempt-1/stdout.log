rom '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\n\ndescribe('Task entity', () => {\n  test(covers(['invariant:Task/titulo-obrigatorio', 'method:Task.create', 'criterion:0001/titulo-invalido'], 'rejeita título vazio ao criar tarefa'), () => {\n    let error: unknown;\n    try {\n      Task.create('t1', '   ');\n    } catch (caught) {\n      error = caught;\n    }\n    expect(error).toBeInstanceOf(DomainError);\n    expect((error as DomainError).code).toBe('TASK_TITLE_REQUIRED');\n  });\n\n  test(covers(['method:Task.create', 'criterion:0001/criacao'], 'cria tarefa pending, normaliza título e registra TaskCreated'), () => {\n    const task = Task.create('t1', '  Estudar DDD  ');\n    expect(task.id).toBe('t1');\n    expect(task.status).toBe('pending');\n    expect(task.title).toBe('Estudar DDD');\n    const events = task.pullEvents();\n    expect(events).toHaveLength(1);\n    expect(events[0]).toBeInstanceOf(TaskCreated);\n    expect((events[0] as TaskCreated).payload).toEqual({ taskId: 't1', title: 'Estudar DDD' });\n  });\n});\n","message":"Success. Updated the following files:\nA /tmp/agentic-eval-ggd69E/attempt-yMB9l7/workspace/app/test/entity-Task.test.ts"}}},"hookAdditionalContexts":[],"toolCallId":"call_nfjeg0PzgKxt5b99279CCHfu\nctc_0fa42a2e742748e3016acaa176afd087d1a49da5c8d56b8648","startedAtMs":"1791664502788","completedAtMs":"1791664504780"},"model_call_id":"b6b2a09e-ed2f-4a4c-bf3d-44004864f1fa-12-8ljo","session_id":"f60e863e-804a-4d95-ab7f-9d6bcc2dbfe9","timestamp_ms":1791664503914}
