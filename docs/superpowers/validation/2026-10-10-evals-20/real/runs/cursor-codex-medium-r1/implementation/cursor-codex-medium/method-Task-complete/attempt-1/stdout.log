ndescribe('Task.complete method', () => {\n  test(covers(['method:Task.complete', 'criterion:0001/conclusao'], 'conclui tarefa pending, registra TaskCompleted e rejeita repeticao'), () => {\n    const task = Task.create('t1', 'Estudar DDD');\n    task.pullEvents();\n\n    task.complete();\n\n    expect(task.status).toBe('completed');\n    const completionEvents = task.pullEvents();\n    expect(completionEvents).toHaveLength(1);\n    expect(completionEvents[0]).toBeInstanceOf(TaskCompleted);\n    expect((completionEvents[0] as TaskCompleted).payload).toEqual({ taskId: 't1' });\n\n    let error: unknown;\n    try {\n      task.complete();\n    } catch (caught) {\n      error = caught;\n    }\n\n    expect(error).toBeInstanceOf(DomainError);\n    expect((error as DomainError).code).toBe('TASK_ALREADY_COMPLETED');\n    expect(task.pullEvents()).toHaveLength(0);\n  });\n});\n","message":"Success. Updated the following files:\nA /tmp/agentic-eval-ggd69E/attempt-VVO5gz/workspace/app/test/method-Task-complete.test.ts"}}},"hookAdditionalContexts":[],"toolCallId":"call_H17STsnAAeYlMKK7qGXhWqGW\nctc_0d377fc4e5b672e7016acaa1dacba087d1b821465fedf19b52","startedAtMs":"1791664602829","completedAtMs":"1791664605135"},"model_call_id":"9617ad43-3a6c-42ae-bde4-2075c49f96f9-7-7ull","session_id":"57c1ce8d-68b1-4efd-b954-43b038bb1b0f","timestamp_ms":1791664604265}
