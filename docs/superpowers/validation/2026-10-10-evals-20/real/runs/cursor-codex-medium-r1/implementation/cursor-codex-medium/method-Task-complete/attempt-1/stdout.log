inError('TASK_TITLE_REQUIRED', 'Toda tarefa precisa de título não vazio.'); const task = new Task(id, normalizedTitle); task.record(new TaskCreated({ taskId: id, title: normalizedTitle })); return task;\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n\n  @AgentMethod({ description: 'Conclui uma tarefa pendente; repetição falha com TASK_ALREADY_COMPLETED.', transition: { from: ['pending'], to: 'completed' }, emits: [TaskCompleted] })\n  complete(): void {\n    return notImplemented();\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n}\n","afterFullFileContent":"import { AggregateRoot, DomainError, notImplemented } from '@agentic-ddd/core';\nimport { AgentEntity, AgentMethod, Invariant } from '@agentic-ddd/decorators';\nimport { TaskCreated, TaskCompleted } from './task.events';\n\n@AgentEntity({ description: 'Tarefa com título e ciclo de vida pendente ou concluído.', states: ['pending', 'completed'] })\n@Invariant({ id: 'titulo-obrigatorio', text: 'Toda tarefa precisa de título não vazio.' })\nexport class Task extends AggregateRoot<string> {\n  #status: 'pending' | 'completed' = 'pending';\n  private constructor(id: string, readonly title: string) { super(id); }\n  get status(): 'pending' | 'completed' { return this.#status; }\n\n  @AgentMethod({ description: 'Cria uma tarefa pendente e remove espaços nas extremidades do título.', emits: [TaskCreated] })\n  static create(id: string, title: string): Task {\n    const normalizedTitle = title.trim(); if (normalizedTitle.length === 0) throw new DomainError('TASK_TITLE_REQUIRED', 'Toda tarefa precisa de título não vazio.'); const task = new Task(id, normalizedTitle); task.record(new TaskCreated({ taskId: id, title: normalizedTitle })); return task;\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n\n  @AgentMethod({ description: 'Conclui uma tarefa pendente; repetição falha com TASK_ALREADY_COMPLETED.', transition: { from: ['pending'], to: 'completed' }, emits: [TaskCompleted] })\n  complete(): void {\n    if (this.#status === 'completed') throw new DomainError('TASK_ALREADY_COMPLETED', 'Tarefa já foi concluída.'); this.#status = 'completed'; this.record(new TaskCompleted({ taskId: this.id }));\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n}\n","message":"The file /tmp/agentic-eval-ggd69E/attempt-VVO5gz/workspace/app/domain/task.ts has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"call_Va0rgWoj44hZIfVvTAfKwn5t\nctc_0d377fc4e5b672e7016acaa1d8802c87d190184b4b2455b507","startedAtMs":"1791664600540","completedAtMs":"1791664601823"},"model_call_id":"9617ad43-3a6c-42ae-bde4-2075c49f96f9-6-qotm","session_id":"57c1ce8d-68b1-4efd-b954-43b038bb1b0f","timestamp_ms":1791664600953}
