 {\n        \"customer_id\": {\n          \"description\": \"Id do cliente\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        },\n        \"items\": {\n          \"description\": \"Itens do pedido\",\n          \"items\": {\n            \"properties\": {\n              \"quantity\": {\n                \"description\": \"Quantidade\",\n                \"exclusiveMinimum\": 0,\n                \"maximum\": 9007199254740991,\n                \"type\": \"integer\"\n              },\n              \"sku\": {\n                \"description\": \"Código do produto\",\n                \"minLength\": 1,\n                \"type\": \"string\"\n              },\n              \"unit_price\": {\n                \"description\": \"Preço unitário em reais\",\n                \"minimum\": 0,\n                \"type\": \"number\"\n              }\n            },\n            \"required\": [\n              \"sku\",\n              \"quantity\",\n              \"unit_price\"\n            ],\n            \"type\": \"object\"\n          },\n          \"minItems\": 1,\n          \"type\": \"array\"\n        },\n        \"order_id\": {\n          \"description\": \"Id do novo pedido\",\n          \"minLength\": 1,\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"order_id\",\n        \"customer_id\",\n        \"items\"\n      ],\n      \"type\": \"object\"\n    },\n    \"output\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"order_id\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"const\": \"pending\",\n          \"type\": \"string\"\n        },\n        \"total\": {\n          \"type\": \"number\"\n        }\n      },\n      \"required\": [\n        \"order_id\",\n        \"status\",\n        \"total\"\n      ],\n      \"type\": \"object\"\n    }\n  }\n}\n","isEmpty":false,"exceededLimit":false,"totalLines":147,"fileSize":3141,"path":"/tmp/agentic-eval-ggd69E/att