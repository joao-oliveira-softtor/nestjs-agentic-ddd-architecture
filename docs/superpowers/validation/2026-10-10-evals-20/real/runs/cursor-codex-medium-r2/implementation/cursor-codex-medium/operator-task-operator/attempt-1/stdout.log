ainError).code).toBe('TASK_NOT_FOUND');\n  });\n});\n","isEmpty":false,"exceededLimit":false,"totalLines":37,"fileSize":1710,"path":"/tmp/agentic-eval-Vs9JGs/attempt-Vbw3sE/workspace/app/test/usecase-complete_task.test.ts","readRange":{"startLine":1,"endLine":37},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call_pask5vNzZcLmPeFZq3b3uWXr\nfc_05df66dfa2638d29016acaa5bb4e6087d19d7d906dc63eaadd","startedAtMs":"1791665595411","completedAtMs":"1791665595583"},"model_call_id":"c3b9e596-0b55-4ffe-afa9-d9451a3c913b-3-ediy","session_id":"7d67aa38-a07b-4cf1-97d4-eebe6e83c10d","timestamp_ms":1791665594700}
