z.string().min(1), title: z.string().min(1) });\nexport const createTaskOutput = z.object({ task_id: z.string(), title: z.string(), status: z.literal('pending') });\nexport type CreateTaskInput = z.infer<typeof createTaskInput>;\nexport type CreateTaskOutput = z.infer<typeof createTaskOutput>;\n\n@AgentUseCase({ name: 'create_task', description: 'Cria, salva e publica uma tarefa pendente; id repetido falha com TASK_ALREADY_EXISTS.', whenToUse: 'Quando o usuário deseja criar uma tarefa.', whenNotToUse: 'Para concluir tarefa existente.', input: createTaskInput, output: createTaskOutput, uses: ['method:Task.create'], emits: [TaskCreated] })\nexport class CreateTask implements UseCase<CreateTaskInput, CreateTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CreateTaskInput, ctx: UseCaseContext): Promise<CreateTaskOutput> {\n    const existing = await this.tasks.findById(input.task_id); if (existing) throw new DomainError('TASK_ALREADY_EXISTS', 'Tarefa já existe.'); const task = Task.create(input.task_id, input.title); await this.tasks.save(task); const events = task.pullEvents(); await ctx.publish(events); return { task_id: task.id, title: task.title, status: task.status };\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n}\n","afterFullFileContent":"import { z } from 'zod';\nimport { DomainError, notImplemented, type UseCase, type UseCaseContext } from '@agentic-ddd/core';\nimport { AgentUseCase } from '@agentic-ddd/decorators';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\n\nexport const createTaskInput = z.object({ task_id: z.string().min(1), title: z.string().min(1) });\nexport const createTaskOutput = z.object({ task_id: z.string(), title: z.string(), status: z.literal('pending') });\nexport type CreateTaskInput = z.infer<typeof createTaskInput>;\nexport type CreateTaskOutput = z.infer<typeof createTaskOutput>;\n\n@AgentUseCase({ name: 'create_task', description: 'Cria, salva e publica uma tarefa pendente; id repetido falha com TASK_ALREADY_EXISTS.', whenToUse: 'Quando o usuário deseja criar uma tarefa.', whenNotToUse: 'Para concluir tarefa existente.', input: createTaskInput, output: createTaskOutput, uses: ['method:Task.create'], emits: [TaskCreated] })\nexport class CreateTask implements UseCase<CreateTaskInput, CreateTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CreateTaskInput, ctx: UseCaseContext): Promise<CreateTaskOutput> {\n    const existing = await this.tasks.findById(input.task_id); if (existing) throw new DomainError('TASK_ALREADY_EXISTS', 'Tarefa já existe.'); const task = Task.create(input.task_id, input.title); await this.tasks.save(task); const events = task.pullEvents(); await ctx.publish(events); return { task_id: task.id, title: task.title, status: 'pending' };\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n}\n","message":"The file /tmp/agentic-eval-Vs9JGs/attempt-B0S2mZ/workspace/app/application/create-task.ts has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"call_1shNSrCuPgB9mhqE791myyL1\nctc_08c2320dd0b125e0016acaa59b6e7487d1a30a1a8e300052e6","startedAtMs":"1791665563528","completedAtMs":"1791665564792"},"model_call_id":"eab43587-7a4c-4c8b-ad19-45e85fe30b44-9-n1xf","session_id":"848b7f9b-7b00-4bbd-a218-47bd6abe59fd","timestamp_ms":1791665563911}
