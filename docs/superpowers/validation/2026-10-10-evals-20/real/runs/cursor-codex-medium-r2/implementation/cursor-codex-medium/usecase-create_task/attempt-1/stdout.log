', title: 'titulo' });\n+\n+    let error: unknown;\n+    try {\n+      await useCase.execute({ task_id: 't1', title: 'outro titulo' }, ctx);\n+    } catch (caught) {\n+      error = caught;\n+    }\n+    expect(error).toBeInstanceOf(DomainError);\n+    expect((error as DomainError).code).toBe('TASK_ALREADY_EXISTS');\n+    expect(published).toHaveLength(1);\n+  });\n+});","afterFullFileContent":"import { describe, expect, test } from 'bun:test';\nimport { DomainError, type DomainEvent, type UseCaseContext } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { CreateTask } from '../application/create-task';\nimport { TaskCreated } from '../domain/task.events';\nimport { InMemoryTaskRepository } from '../infrastructure/in-memory-task.repository';\n\ndescribe('create_task', () => {\n  test(covers(['criterion:0001/persistencia-criacao', 'usecase:create_task'], 'salva, publica TaskCreated, retorna pending e rejeita duplicado com TASK_ALREADY_EXISTS'), async () => {\n    const tasks = new InMemoryTaskRepository();\n    const published: DomainEvent[][] = [];\n    const ctx: UseCaseContext = { correlationId: 'corr-1', causationId: 'cause-1', publish: async (events) => { published.push([...events]); } };\n    const useCase = new CreateTask(tasks);\n\n    const output = await useCase.execute({ task_id: 't1', title: '  titulo  ' }, ctx);\n    expect(output).toEqual({ task_id: 't1', title: 'titulo', status: 'pending' });\n    expect((await tasks.findById('t1'))?.title).toBe('titulo');\n    expect((await tasks.findById('t1'))?.status).toBe('pending');\n    expect(published).toHaveLength(1);\n    expect(published[0]).toHaveLength(1);\n    expect(published[0][0]).toBeInstanceOf(TaskCreated);\n    expect((published[0][0] as TaskCreated).payload).toEqual({ taskId: 't1', title: 'titulo' });\n\n    let error: unknown;\n    try {\n      await useCase.execute({ task_id: 't1', title: 'outro titulo' }, ctx);\n    } catch (caught) {\n      error = caught;\n    }\n    expect(error).toBeInstanceOf(DomainError);\n    expect((error as DomainError).code).toBe('TASK_ALREADY_EXISTS');\n    expect(published).toHaveLength(1);\n  });\n});\n","message":"Success. Updated the following files:\nA /tmp/agentic-eval-Vs9JGs/attempt-B0S2mZ/workspace/app/test/usecase-create_task.test.ts"}}},"hookAdditionalContexts":[],"toolCallId":"call_bNHtRUr4OeK6iMZDp4g9gGzo\nctc_08c2320dd0b125e0016acaa58c922c87d1a234904e359c6ee1","startedAtMs":"1791665548598","completedAtMs":"1791665552066"},"model_call_id":"eab43587-7a4c-4c8b-ad19-45e85fe30b44-6-1bd1","session_id":"848b7f9b-7b00-4bbd-a218-47bd6abe59fd","timestamp_ms":1791665551186}
