altere decorators, declarações, propostas nem arquivos gerados.\n- Não implemente outros itens. Preserve os contratos e IDs de invariantes.\n\n## Comando de verificação\n\n```bash\nbun run agentic verify --item entity:Task --spec-hash e812964d310ea8fde3c4fa0dc8891177adc0150b7579cbea24c2fa8c61c8837c --config /tmp/agentic-eval-Vs9JGs/attempt-eRGkt2/workspace/agentic.config.ts --json\n```\n\nEnd packet\nRoot atual: /tmp/agentic-eval-Vs9JGs/attempt-kNEZur/workspace; configuração atual: /tmp/agentic-eval-Vs9JGs/attempt-kNEZur/workspace/agentic.config.ts. Use esses paths no lugar de paths temporários do packet; conserve o specHash original e812964d310ea8fde3c4fa0dc8891177adc0150b7579cbea24c2fa8c61c8837c.\nEdite somente app/domain/task.ts Task.create (somente interior do corpo, mesma quantidade de linhas) e o novo teste app/test/entity-Task.test.ts. Preserve imports, contratos, decorators, outros corpos, testes existentes, configurações, propostas e gerados.\nCritérios adicionais arquivados: [{\"id\":\"criterion:0001/titulo-invalido\",\"given\":\"um título vazio ou com apenas espaços\",\"when\":\"criar uma tarefa\",\"then\":\"rejeita com TASK_TITLE_REQUIRED\"},{\"id\":\"criterion:0001/criacao\",\"given\":\"id t1 e título com espaços nas extremidades\",\"when\":\"criar a tarefa\",\"then\":\"fica pending, normaliza o título e registra TaskCreated\"}]. Cubra-os com covers do executor.\nLeia .agents/skills/agentic-ddd/SKILL.md e referências de executor pertinentes. Use só a sessão principal, sem delegação ou subagentes. Neste benchmark, este protocolo de resposta final substitui o handoff normal da skill/referência de executor. Resposta final: objeto JSON com exatamente duas propriedades, status e summary; sem propriedades adicionais. Exemplo {\"status\":\"done\",\"summary\":\"texto\"}; status deve ser done, blocked ou failed, sem prosa ou cercas.\nCorrection: aplique uma nova submissão a partir deste baseline; nenhuma edição anterior foi reaplicada. Patch anterior: [\n  {\n    \"path\": \"app/domain/task.ts\",\n    \"before\": {\n      \"kind\": \"file\",\n      \"mode\": 33188,\n      \"hash\": \"17f303d04ef10815f03a1a0a97d7653843d5afed0a567b8061c1676bb94e3a96\",\n      \"content\": \"import { AggregateRoot, DomainError, notImplemented } from '@agentic-ddd/core';\\nimport { AgentEntity, AgentMethod, Invariant } from '@agentic-ddd/decorators';\\nimport { TaskCreated, TaskCompleted } from './task.events';\\n\\n@AgentEntity({ description: 'Tarefa com título e ciclo de vida pendente ou concluído.', states: ['pending', 'completed'] })\\n@Invariant({ id: 'titulo-obrigatorio', text: 'Toda tarefa precisa de título não vazio.' })\\nexport class Task extends AggregateRoot<string> {\\n  #status: 'pending' | 'completed' = 'pending';\\n  private constructor(id: string, readonly title: string) { super(id); }\\n  get status(): 'pending' | 'completed' { return this.#status; }\\n\\n  @AgentMethod({ description: 'Cria uma tarefa pendente e remove espaços nas extremidades do título.', emits: [TaskCreated] })\\n  static create(id: string, title: string): Task {\\n    return notImplemented();\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n  }\\n\\n  @AgentMethod({ description: 'Conclui uma tarefa pendente; repetição falha com TASK_ALREADY_COMPLETED.', transition: { from: ['pending'], to: 'completed' }, emits: [TaskCompleted] })\\n  complete(): void {\\n    return notImplemented();\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n  }\\n}\\n\"\n    },\n    \"after\": {\n      \"kind\": \"file\",\n      \"mode\": 33188,\n      \"hash\": \"7e5485bba36e775fb2165ff1b974879918159cff8e10c2cebf84bdcb2cef1827\",\n      \"content\": \"import { AggregateRoot, DomainError, notImplemented } from '@agentic-ddd/core';\\nimport { AgentEntity, AgentMethod, Invariant } from '@agentic-ddd/decorators';\\nimport { TaskCreated, TaskCompleted } from './task.events';\\n\\n@AgentEntity({ description: 'Tarefa com título e ciclo de vida pendente ou concluído.', states: ['pending', 'completed'] })\\n@Invariant({ id: 'titulo-obrigatorio', text: 'Toda tarefa precisa de título não vazio.' })\\nexport class Task extends AggregateRoot<string> {\\n  #status: 'pending' | 'completed' = 'pending';\\n  private constructor(id: string, readonly title: string) { super(id); }\\n  get status(): 'pending' | 'completed' { return this.#status; }\\n\\n  @AgentMethod({ description: 'Cria uma tarefa pendente e remove espaços nas extremidades do título.', emits: [TaskCreated] })\\n  static create(id: string, title: string): Task {\\n    const normalizedTitle = title.trim();\\n    if (normalizedTitle.length === 0) {\\n      throw new DomainError('TASK_TITLE_REQUIRED', 'Toda tarefa precisa de título não vazio.');\\n    }\\n    const task = new Task(id, normalizedTitle);\\n    task.record(new TaskCreated({ taskId: id, title: normalizedTitle }));\\n    return task;\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n  }\\n\\n  @AgentMethod({ description: 'Conclui uma tarefa pendente; repetição falha com TASK_ALREADY_COMPLETED.', transition: { from: ['pending'], to: 'completed' }, emits: [TaskCompleted] })\\n  complete(): void {\\n    return notImplemented();\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n  }\\n}\\n\"\n    }\n  },\n  {\n    \"path\": \"app/test\",\n    \"before\": null,\n    \"after\": {\n      \"kind\": \"directory\",\n      \"mode\": 16877,\n      \"hash\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n      \"content\": \"\"\n    }\n  },\n  {\n    \"path\": \"app/test/entity-Task.test.ts\",\n    \"before\": null,\n    \"after\": {\n      \"kind\": \"file\",\n      \"mode\": 33188,\n      \"hash\": \"8f1ed3b50160ff5807b28da6f075112769a754027de2666d99b3822341038f23\",\n      \"content\": \"import { describe, expect, test } from 'bun:test';\\nimport { DomainError } from '@agentic-ddd/core';\\nimport { covers } from '@agentic-ddd/testing';\\nimport { Task } from '../domain/task';\\nimport { TaskCreated } from '../domain/task.events';\\n\\ndescribe('Task.create', () => {\\n  test(covers(['criterion:0001/titulo-invalido', 'invariant:Task/titulo-obrigatorio', 'method:Task.create'], 'rejeita título vazio ou com espaços'), () => {\\n    let error: unknown;\\n    try {\\n      Task.create('t1', '   ');\\n    } catch (caught) {\\n      error = caught;\\n    }\\n    expect(error).toBeInstanceOf(DomainError);\\n    expect((error as DomainError).code).toBe('TASK_TITLE_REQUIRED');\\n  });\\n\\n  test(covers(['criterion:0001/criacao', 'method:Task.create'], 'cria pending, normaliza título e registra TaskCreated'), () => {\\n    const task = Task.create('t1', '  titulo com espacos  ');\\n    expect(task.status).toBe('pending');\\n    expect(task.title).toBe('titulo com espacos');\\n\\n    const events = task.pullEvents();\\n    expect(events).toHaveLength(1);\\n    expect(events[0]).toBeInstanceOf(TaskCreated);\\n    expect((events[0] as TaskCreated).payload).toEqual({ taskId: 't1', title: 'titulo com espacos' });\\n  });\\n});\\n\"\n    }\n  }\n]. Findings: [\"Body line count changed: app/domain/task.ts\"]"}]},"session_id":"c81894ac-5af6-48d0-9ed9-00b4e6e53418"}
