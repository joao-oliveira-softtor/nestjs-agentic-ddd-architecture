k';\nimport { TaskCreated } from '../domain/task.events';\n\ndescribe('Task.create', () => {\n  test(covers(['criterion:0001/titulo-invalido', 'invariant:Task/titulo-obrigatorio', 'method:Task.create'], 'rejeita titulo vazio ou com espacos'), () => {\n    let error: unknown;\n    try {\n      Task.create('t1', '   ');\n    } catch (caught) {\n      error = caught;\n    }\n    expect(error).toBeInstanceOf(DomainError);\n    expect((error as DomainError).code).toBe('TASK_TITLE_REQUIRED');\n  });\n\n  test(covers(['criterion:0001/criacao', 'method:Task.create'], 'cria pending, normaliza titulo e registra TaskCreated'), () => {\n    const task = Task.create('t1', '  titulo com espacos  ');\n    expect(task.status).toBe('pending');\n    expect(task.title).toBe('titulo com espacos');\n\n    const events = task.pullEvents();\n    expect(events).toHaveLength(1);\n    expect(events[0]).toBeInstanceOf(TaskCreated);\n    expect((events[0] as TaskCreated).payload).toEqual({ taskId: 't1', title: 'titulo com espacos' });\n  });\n});\n","message":"Success. Updated the following files:\nA /tmp/agentic-eval-Vs9JGs/attempt-kNEZur/workspace/app/test/entity-Task.test.ts"}}},"hookAdditionalContexts":[],"toolCallId":"call_9JdTpUvCNQFTz3aGpP5MdyJo\nctc_02923df67a1d8274016acaa4d1db4087d1bdecf718473b9e04","startedAtMs":"1791665361929","completedAtMs":"1791665364388"},"model_call_id":"97f8768d-496c-424f-b7ca-90c6e3ef04b1-5-3sg2","session_id":"c81894ac-5af6-48d0-9ed9-00b4e6e53418","timestamp_ms":1791665363514}
