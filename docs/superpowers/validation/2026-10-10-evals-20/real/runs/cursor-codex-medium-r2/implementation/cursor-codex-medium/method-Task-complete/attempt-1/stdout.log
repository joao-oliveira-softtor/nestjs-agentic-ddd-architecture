ror('TASK_TITLE_REQUIRED', 'Toda tarefa precisa de título não vazio.'); const task = new Task(id, normalizedTitle); task.record(new TaskCreated({ taskId: id, title: normalizedTitle })); return task;\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n\n  @AgentMethod({ description: 'Conclui uma tarefa pendente; repetição falha com TASK_ALREADY_COMPLETED.', transition: { from: ['pending'], to: 'completed' }, emits: [TaskCompleted] })\n  complete(): void {\n    return notImplemented();\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n}\n","afterFullFileContent":"import { AggregateRoot, DomainError, notImplemented } from '@agentic-ddd/core';\nimport { AgentEntity, AgentMethod, Invariant } from '@agentic-ddd/decorators';\nimport { TaskCreated, TaskCompleted } from './task.events';\n\n@AgentEntity({ description: 'Tarefa com título e ciclo de vida pendente ou concluído.', states: ['pending', 'completed'] })\n@Invariant({ id: 'titulo-obrigatorio', text: 'Toda tarefa precisa de título não vazio.' })\nexport class Task extends AggregateRoot<string> {\n  #status: 'pending' | 'completed' = 'pending';\n  private constructor(id: string, readonly title: string) { super(id); }\n  get status(): 'pending' | 'completed' { return this.#status; }\n\n  @AgentMethod({ description: 'Cria uma tarefa pendente e remove espaços nas extremidades do título.', emits: [TaskCreated] })\n  static create(id: string, title: string): Task {\n    const normalizedTitle = title.trim(); if (normalizedTitle.length === 0) throw new DomainError('TASK_TITLE_REQUIRED', 'Toda tarefa precisa de título não vazio.'); const task = new Task(id, normalizedTitle); task.record(new TaskCreated({ taskId: id, title: normalizedTitle })); return task;\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n\n  @AgentMethod({ description: 'Conclui uma tarefa pendente; repetição falha com TASK_ALREADY_COMPLETED.', transition: { from: ['pending'], to: 'completed' }, emits: [TaskCompleted] })\n  complete(): void {\n    if (this.#status === 'completed') throw new DomainError('TASK_ALREADY_COMPLETED', 'Tarefa já concluída.'); this.#status = 'completed'; this.record(new TaskCompleted({ taskId: this.id }));\n\n\n\n\n\n\n\n\n\n\n\n\n\n  }\n}\n","message":"The file /tmp/agentic-eval-Vs9JGs/attempt-z6Hrzl/workspace/app/domain/task.ts has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"call_SjS82OvOkOCoqyDXBdBYRCRN\nctc_0feb1d86bcc4ac82016acaa5046ea087d1afa9833425793341","startedAtMs":"1791665412463","completedAtMs":"1791665413730"},"model_call_id":"ff161860-44da-4e23-8180-323b3c8b7fe5-7-d0f4","session_id":"05384c3c-a480-4516-b957-a4812b201af2","timestamp_ms":1791665412854}
