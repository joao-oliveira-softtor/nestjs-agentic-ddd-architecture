k';\nimport { TaskCreated } from '../domain/task.events';\n\ndescribe('Task.create', () => {\n  test(covers(['criterion:0001/titulo-invalido', 'invariant:Task/titulo-obrigatorio', 'method:Task.create'], 'rejeita título vazio ou com espaços'), () => {\n    let error: unknown;\n    try {\n      Task.create('t1', '   ');\n    } catch (caught) {\n      error = caught;\n    }\n    expect(error).toBeInstanceOf(DomainError);\n    expect((error as DomainError).code).toBe('TASK_TITLE_REQUIRED');\n  });\n\n  test(covers(['criterion:0001/criacao', 'method:Task.create'], 'cria pending, normaliza título e registra TaskCreated'), () => {\n    const task = Task.create('t1', '  titulo com espacos  ');\n    expect(task.status).toBe('pending');\n    expect(task.title).toBe('titulo com espacos');\n\n    const events = task.pullEvents();\n    expect(events).toHaveLength(1);\n    expect(events[0]).toBeInstanceOf(TaskCreated);\n    expect((events[0] as TaskCreated).payload).toEqual({ taskId: 't1', title: 'titulo com espacos' });\n  });\n});\n","message":"Success. Updated the following files:\nA /tmp/agentic-eval-Vs9JGs/attempt-SGA2QL/workspace/app/test/entity-Task.test.ts"}}},"hookAdditionalContexts":[],"toolCallId":"call_VtZNZtujFMMxHrRjFkMLOCtr\nctc_0c25398f40d3eb20016acaa4a5534c87d1accc66398f5277b4","startedAtMs":"1791665317409","completedAtMs":"1791665319759"},"model_call_id":"928f60cc-2cfb-41aa-800d-915836f5ffb9-16-ds39","session_id":"1ec1028c-f636-4531-b618-2ad812279ded","timestamp_ms":1791665318885}
