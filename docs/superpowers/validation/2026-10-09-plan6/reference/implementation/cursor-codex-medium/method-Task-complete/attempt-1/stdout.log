Completed e rejeita repeticao'), () => {\n    const task = Task.create('t1', 'tarefa');\n\n    task.pullEvents();\n    task.complete();\n\n    expect(task.status).toBe('completed');\n    const events = task.pullEvents();\n    expect(events).toHaveLength(1);\n    expect(events[0]).toBeInstanceOf(TaskCompleted);\n    expect(events[0]!.payload).toEqual({ taskId: 't1' });\n\n    try {\n      task.complete();\n      throw new Error('expected DomainError');\n    } catch (error) {\n      expect(error).toBeInstanceOf(DomainError);\n      expect((error as DomainError).code).toBe('TASK_ALREADY_COMPLETED');\n    }\n  });\n});\n","message":"Success. Updated the following files:\nA /tmp/agentic-eval-5FI6Md/attempt-2AKGIw/workspace/app/test/method-Task-complete.test.ts"}}},"hookAdditionalContexts":[],"toolCallId":"call_rqUjkCbSUhbeSEL3Pi2ArduO\nctc_02ef01df24f1c4ec016ac87939d73887d19a14086bcf72bb69","startedAtMs":"1791523129869","completedAtMs":"1791523132897"},"model_call_id":"1c4572ae-03b1-4f83-81f7-5d4dc05e72cc-6-qba4","session_id":"389919e8-1af1-4ba8-bc18-a6e9883f7d00","timestamp_ms":1791523131293}
