tle: 'outra' }, ctx);\n+      throw new Error('expected DomainError');\n+    } catch (error) {\n+      expect(error).toBeInstanceOf(DomainError);\n+      expect((error as DomainError).code).toBe('TASK_ALREADY_EXISTS');\n+    }\n+  });\n+});","afterFullFileContent":"import { describe, expect, it } from 'bun:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { CreateTask } from '../application/create-task';\nimport { TaskCreated } from '../domain/task.events';\nimport { InMemoryTaskRepository } from '../infrastructure/in-memory-task.repository';\n\ndescribe('create_task use-case', () => {\n  it(covers(['usecase:create_task', 'criterion:0001/persistencia-criacao'], 'salva pending, publica TaskCreated, retorna pending e rejeita duplicado com TASK_ALREADY_EXISTS'), async () => {\n    const tasks = new InMemoryTaskRepository();\n    const published: unknown[] = [];\n    const useCase = new CreateTask(tasks);\n    const ctx = { correlationId: 'c1', causationId: 'c1', publish: async (events: readonly unknown[]) => { published.push(...events); } };\n\n    const output = await useCase.execute({ task_id: 't1', title: '  tarefa  ' }, ctx);\n    expect(output).toEqual({ task_id: 't1', title: 'tarefa', status: 'pending' });\n    const saved = await tasks.findById('t1');\n    expect(saved?.status).toBe('pending');\n    expect(saved?.title).toBe('tarefa');\n    expect(published).toHaveLength(1);\n    expect(published[0]).toBeInstanceOf(TaskCreated);\n    expect((published[0] as TaskCreated).payload).toEqual({ taskId: 't1', title: 'tarefa' });\n\n    try {\n      await useCase.execute({ task_id: 't1', title: 'outra' }, ctx);\n      throw new Error('expected DomainError');\n    } catch (error) {\n      expect(error).toBeInstanceOf(DomainError);\n      expect((error as DomainError).code).toBe('TASK_ALREADY_EXISTS');\n    }\n  });\n});\n","message":"Success. Updated the following files:\nA /tmp/agentic-eval-5FI6Md/attempt-Wl