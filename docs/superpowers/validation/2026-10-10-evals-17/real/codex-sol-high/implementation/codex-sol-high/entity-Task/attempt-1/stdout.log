roperties\": false,\n        \"properties\": {\n          \"status\": {\n            \"const\": \"pending\",\n            \"type\": \"string\"\n          },\n          \"task_id\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"task_id\",\n          \"title\",\n          \"status\"\n        ],\n        \"type\": \"object\"\n      }\n    }\n  }\n}\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"preserve\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"experimentalDecorators\": true,\n    \"emitDecoratorMetadata\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"noEmit\": true,\n    \"types\": [\n      \"bun\"\n    ],\n    \"paths\": {\n      \"@agentic-ddd/*\": [\n        \"/tmp/agentic-eval-KI6lCe/framework/src/*/index.ts\"\n      ],\n      \"zod\": [\n        \"/tmp/agentic-eval-KI6lCe/framework/node_modules/zod\"\n      ]\n    }\n  },\n  \"include\": [\n    \"app/**/*.ts\",\n    \"agentic.config.ts\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
