{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/usr/bin/zsh -lc 'cat app/operators/task.operator.ts app/infrastructure/in-memory-task.repository.ts app/domain/task.ts app/domain/task.events.ts app/domain/task.repository.ts app/application/create-task.ts app/application/complete-task.ts app/test/*.test.ts tsconfig.json'","aggregated_output":"import { Operator } from '@agentic-ddd/decorators';\nimport { CreateTask } from '../application/create-task';\nimport { CompleteTask } from '../application/complete-task';\n\n@Operator({ name: 'task-operator', description: 'Cria e conclui tarefas conforme pedido do usuário.', instructions: 'Use as tools para criar e concluir tarefas. Identifique a tarefa pelo id e responda em português.', useCases: [CreateTask, CompleteTask] })\nexport class TaskOperator {}\nimport type { TaskRepository } from '../domain/task.repository';\nimport type { Task } from '../domain/task';\n\nexport class InMemoryTaskRepository implements TaskRepository {\n  readonly #tasks = new Map<string, Task>();\n  async findById(id: string): Promise<Task | null> { return this.#tasks.get(id) ?? null; }\n  async save(task: Task): Promise<void> { this.#tasks.set(task.id, task); }\n}\nimport { AggregateRoot, DomainError, notImplemented } from '@agentic-ddd/core';\nimport { AgentEntity, AgentMethod, Invariant } from '@agentic-ddd/decorators';\nimport { TaskCreated, TaskCompleted } from './task.events';\n\n@AgentEntity({ description: 'Tarefa com título e ciclo de vida pendente ou concluído.', states: ['pending', 'completed'] })\n@Invariant({ id: 'titulo-obrigatorio', text: 'Toda tarefa precisa de título não vazio.' })\nexport class Task extends AggregateRoot<string> {\n  #status: 'pending' | 'completed' = 'pending';\n  private constructor(id: string, readonly title: string) { super(id); }\n  get status(): 'pending' | 'completed' { return this.#status; }\n\n  @AgentMethod({ description: 'Cria uma tarefa pendente e remove espaços nas extremidades do título.', emits: [TaskCreated] })\n  static create(id: string, title: string): Task {\n    const normalizedTitle = title.trim();\n    if (!normalizedTitle) {\n      throw new DomainError('TASK_TITLE_REQUIRED', 'Toda tarefa precisa de título não vazio.');\n    }\n    const task = new Task(id, normalizedTitle);\n    task.record(new TaskCreated({ taskId: id, title: normalizedTitle }));\n    return task;\n\n\n\n\n\n\n\n  }\n\n  @AgentMethod({ description: 'Conclui uma tarefa pendente; repetição falha com TASK_ALREADY_COMPLETED.', transition: { from: ['pending'], to: 'completed' }, emits: [TaskCompleted] })\n  complete(): void {\n    if (this.#status === 'completed') {\n      throw new DomainError('TASK_ALREADY_COMPLETED', 'A tarefa já foi concluída.');\n    }\n    this.#status = 'completed';\n    this.record(new TaskCompleted({ taskId: this.id }));\n\n\n\n\n\n\n\n\n\n  }\n}\nimport { z } from 'zod';\nimport { DomainEvent } from '@agentic-ddd/core';\nimport { AgentEvent } from '@agentic-ddd/decorators';\n\n@AgentEvent({ description: 'Uma tarefa foi criada.', payload: z.object({ taskId: z.string(), title: z.string() }) })\nexport class TaskCreated extends DomainEvent<{ readonly taskId: string; readonly title: string }> {}\n\n@AgentEvent({ description: 'Uma tarefa foi concluída.', payload: z.object({ taskId: z.string() }) })\nexport class TaskCompleted extends DomainEvent<{ readonly taskId: string }> {}\nimport type { Repository } from '@agentic-ddd/core';\nimport type { Task } from './task';\nexport type TaskRepository = Repository<Task, string>;\nimport { z } from 'zod';\nimport { DomainError, notImplemented, type UseCase, type UseCaseContext } from '@agentic-ddd/core';\nimport { AgentUseCase } from '@agentic-ddd/decorators';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\n\nexport const createTaskInput = z.object({ task_id: z.string().min(1), title: z.string().min(1) });\nexport const createTaskOutput = z.object({ task_id: z.string(), title: z.string(), status: z.literal('pending') });\nexport type CreateTaskInput = z.infer<typeof createTaskInput>;\nexport type CreateTaskOutput = z.infer<typeof createTaskOutput>;\n\n@AgentUseCase({ name: 'create_task', description: 'Cria, salva e publica uma tarefa pendente; id repetido falha com TASK_ALREADY_EXISTS.', whenToUse: 'Quando o usuário deseja criar uma tarefa.', whenNotToUse: 'Para concluir tarefa existente.', input: createTaskInput, output: createTaskOutput, uses: ['method:Task.create'], emits: [TaskCreated] })\nexport class CreateTask implements UseCase<CreateTaskInput, CreateTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CreateTaskInput, ctx: UseCaseContext): Promise<CreateTaskOutput> {\n    const existing = await this.tasks.findById(input.task_id);\n    if (existing) {\n      throw new DomainError('TASK_ALREADY_EXISTS', 'A tarefa já existe.');\n    }\n    const task = Task.create(input.task_id, input.title);\n    await this.tasks.save(task);\n    await ctx.publish(task.pullEvents());\n    return { task_id: task.id, title: task.title, status: 'pending' };\n\n\n\n\n\n\n  }\n}\nimport { z } from 'zod';\nimport { DomainError, notImplemented, type UseCase, type UseCaseContext } from '@agentic-ddd/core';\nimport { AgentUseCase } from '@agentic-ddd/decorators';\nimport { TaskCompleted } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\n\nexport const completeTaskInput = z.object({ task_id: z.string().min(1) });\nexport const completeTaskOutput = z.object({ task_id: z.string(), status: z.literal('completed') });\nexport type CompleteTaskInput = z.infer<typeof completeTaskInput>;\nexport type CompleteTaskOutput = z.infer<typeof completeTaskOutput>;\n\n@AgentUseCase({ name: 'complete_task', description: 'Carrega, conclui, salva e publica a tarefa; id ausente falha com TASK_NOT_FOUND.', whenToUse: 'Quando o usuário terminou uma tarefa.', whenNotToUse: 'Para criar uma nova tarefa.', input: completeTaskInput, output: completeTaskOutput, uses: ['method:Task.complete'], emits: [TaskCompleted] })\nexport class CompleteTask implements UseCase<CompleteTaskInput, CompleteTaskOutput> {\n  constructor(private readonly tasks: TaskRepository) {}\n  async execute(input: CompleteTaskInput, ctx: UseCaseContext): Promise<CompleteTaskOutput> {\n    const task = await this.tasks.findById(input.task_id);\n    if (!task) {\n      throw new DomainError('TASK_NOT_FOUND', 'A tarefa não foi encontrada.');\n    }\n    task.complete();\n    await this.tasks.save(task);\n    await ctx.publish(task.pullEvents());\n    return { task_id: task.id, status: 'completed' };\n\n\n\n\n\n\n  }\n}\nimport { expect, test } from 'bun:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\n\ntest(covers([\n  'invariant:Task/titulo-obrigatorio',\n  'method:Task.create',\n  'criterion:0001/titulo-invalido',\n], 'rejeita títulos vazios ou compostos apenas por espaços'), () => {\n  for (const title of ['', '   ', '\\t\\n']) {\n    let error: unknown;\n    try {\n      Task.create('t1', title);\n    } catch (caught) {\n      error = caught;\n    }\n    expect(error).toBeInstanceOf(DomainError);\n    expect(error).toHaveProperty('code', 'TASK_TITLE_REQUIRED');\n  }\n});\n\ntest(covers([\n  'method:Task.create',\n  'criterion:0001/criacao',\n], 'cria tarefa pendente com título normalizado e registra TaskCreated'), () => {\n  const task = Task.create('t1', '  Minha tarefa  ');\n\n  expect(task.id).toBe('t1');\n  expect(task.title).toBe('Minha tarefa');\n  expect(task.status).toBe('pending');\n\n  const events = task.pullEvents();\n  expect(events).toHaveLength(1);\n  expect(events[0]).toBeInstanceOf(TaskCreated);\n  expect(events[0]!.payload).toEqual({ taskId: 't1', title: 'Minha tarefa' });\n  expect(task.pullEvents()).toEqual([]);\n});\nimport { expect, test } from 'bun:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { Task } from '../domain/task';\nimport { TaskCompleted } from '../domain/task.events';\n\ntest(covers([\n  'method:Task.complete',\n  'criterion:0001/conclusao',\n], 'conclui tarefa pendente, registra TaskCompleted e rejeita repetição'), () => {\n  const task = Task.create('t1', 'Minha tarefa');\n  task.pullEvents();\n  expect(task.status).toBe('pending');\n\n  task.complete();\n\n  expect(task.status).toBe('completed');\n  const events = task.pullEvents();\n  expect(events).toHaveLength(1);\n  expect(events[0]).toBeInstanceOf(TaskCompleted);\n  expect(events[0]!.payload).toEqual({ taskId: 't1' });\n  expect(task.pullEvents()).toEqual([]);\n\n  let error: unknown;\n  try {\n    task.complete();\n  } catch (caught) {\n    error = caught;\n  }\n  expect(error).toBeInstanceOf(DomainError);\n  expect(error).toHaveProperty('code', 'TASK_ALREADY_COMPLETED');\n  expect(task.status).toBe('completed');\n  expect(task.pullEvents()).toEqual([]);\n});\nimport { expect, test } from 'bun:test';\nimport { DomainError, type DomainEvent, type UseCaseContext } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { CompleteTask } from '../application/complete-task';\nimport { Task } from '../domain/task';\nimport { TaskCompleted } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\nimport { InMemoryTaskRepository } from '../infrastructure/in-memory-task.repository';\n\nfunction setup() {\n  const storage = new InMemoryTaskRepository();\n  const calls: string[] = [];\n  const published: DomainEvent[] = [];\n  const tasks: TaskRepository = {\n    async findById(id) {\n      calls.push(`find:${id}`);\n      return storage.findById(id);\n    },\n    async save(task) {\n      calls.push(`save:${task.id}:${task.status}`);\n      await storage.save(task);\n    },\n  };\n  const ctx: UseCaseContext = {\n    correlationId: 'correlation-1',\n    causationId: 'causation-1',\n    async publish(events) {\n      calls.push('publish');\n      published.push(...events);\n    },\n  };\n  return { storage, calls, published, tasks, ctx, usecase: new CompleteTask(tasks) };\n}\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'carrega t1, salva completed e publica TaskCompleted após salvar'), async () => {\n  const { storage, calls, published, ctx, usecase } = setup();\n  const task = Task.create('t1', 'Minha tarefa');\n  task.pullEvents();\n  await storage.save(task);\n\n  const result = await usecase.execute({ task_id: 't1' }, ctx);\n\n  expect(result).toEqual({ task_id: 't1', status: 'completed' });\n  expect((await storage.findById('t1'))?.status).toBe('completed');\n  expect(calls).toEqual(['find:t1', 'save:t1:completed', 'publish']);\n  expect(published).toHaveLength(1);\n  expect(published[0]).toBeInstanceOf(TaskCompleted);\n  expect(published[0]!.payload).toEqual({ taskId: 't1' });\n  expect(task.pullEvents()).toEqual([]);\n});\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'rejeita id inexistente com TASK_NOT_FOUND sem salvar ou publicar'), async () => {\n  const { calls, published, ctx, usecase } = setup();\n\n  const error = await usecase.execute({ task_id: 'missing' }, ctx).catch(error => error);\n\n  expect(error).toBeInstanceOf(DomainError);\n  expect(error).toHaveProperty('code', 'TASK_NOT_FOUND');\n  expect(calls).toEqual(['find:missing']);\n  expect(published).toEqual([]);\n});\n\ntest(covers(['usecase:complete_task'], 'rejeita conclusão repetida sem salvar ou publicar novamente'), async () => {\n  const { storage, calls, published, ctx, usecase } = setup();\n  const task = Task.create('t1', 'Minha tarefa');\n  task.pullEvents();\n  await storage.save(task);\n  await usecase.execute({ task_id: 't1' }, ctx);\n  calls.length = 0;\n  published.length = 0;\n\n  const error = await usecase.execute({ task_id: 't1' }, ctx).catch(error => error);\n\n  expect(error).toBeInstanceOf(DomainError);\n  expect(error).toHaveProperty('code', 'TASK_ALREADY_COMPLETED');\n  expect(calls).toEqual(['find:t1']);\n  expect(published).toEqual([]);\n  expect(task.status).toBe('completed');\n  expect(task.pullEvents()).toEqual([]);\n});\n\ntest(covers(['usecase:complete_task'], 'propaga falha de persistência sem publicar eventos'), async () => {\n  const { storage, tasks, calls, published, ctx } = setup();\n  const task = Task.create('t1', 'Minha tarefa');\n  task.pullEvents();\n  await storage.save(task);\n  const failure = new Error('Falha ao salvar');\n  tasks.save = async () => { throw failure; };\n\n  const error = await new CompleteTask(tasks).execute({ task_id: 't1' }, ctx).catch(error => error);\n\n  expect(error).toBe(failure);\n  expect(calls).toEqual(['find:t1']);\n  expect(published).toEqual([]);\n});\nimport { expect, test } from 'bun:test';\nimport { DomainError, type DomainEvent, type UseCaseContext } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { CreateTask } from '../application/create-task';\nimport { TaskCreated } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\nimport { InMemoryTaskRepository } from '../infrastructure/in-memory-task.repository';\n\nfunction setup() {\n  const storage = new InMemoryTaskRepository();\n  const calls: string[] = [];\n  const published: DomainEvent[] = [];\n  const tasks: TaskRepository = {\n    async findById(id) {\n      calls.push(`find:${id}`);\n      return storage.findById(id);\n    },\n    async save(task) {\n      calls.push(`save:${task.id}:${task.status}`);\n      await storage.save(task);\n    },\n  };\n  const ctx: UseCaseContext = {\n    correlationId: 'correlation-1',\n    causationId: 'causation-1',\n    async publish(events) {\n      calls.push('publish');\n      published.push(...events);\n    },\n  };\n  return { storage, calls, published, tasks, ctx, usecase: new CreateTask(tasks) };\n}\n\ntest(covers([\n  'usecase:create_task',\n  'criterion:0001/persistencia-criacao',\n], 'salva t1 pendente, publica TaskCreated e rejeita repetição com TASK_ALREADY_EXISTS'), async () => {\n  const { storage, calls, published, ctx, usecase } = setup();\n  expect(await storage.findById('t1')).toBeNull();\n\n  const result = await usecase.execute({ task_id: 't1', title: '  Minha tarefa  ' }, ctx);\n\n  expect(result).toEqual({ task_id: 't1', title: 'Minha tarefa', status: 'pending' });\n  const saved = await storage.findById('t1');\n  expect(saved).not.toBeNull();\n  expect(saved!.id).toBe('t1');\n  expect(saved!.title).toBe('Minha tarefa');\n  expect(saved!.status).toBe('pending');\n  expect(calls).toEqual(['find:t1', 'save:t1:pending', 'publish']);\n  expect(published).toHaveLength(1);\n  expect(published[0]).toBeInstanceOf(TaskCreated);\n  expect(published[0]!.payload).toEqual({ taskId: 't1', title: 'Minha tarefa' });\n  expect(saved!.pullEvents()).toEqual([]);\n\n  const error = await usecase.execute({ task_id: 't1', title: 'Outro título' }, ctx).catch(error => error);\n\n  expect(error).toBeInstanceOf(DomainError);\n  expect(error).toHaveProperty('code', 'TASK_ALREADY_EXISTS');\n  expect(calls).toEqual(['find:t1', 'save:t1:pending', 'publish', 'find:t1']);\n  expect(published).toHaveLength(1);\n  expect(await storage.findById('t1')).toBe(saved);\n  expect(saved!.title).toBe('Minha tarefa');\n  expect(saved!.status).toBe('pending');\n});\n\ntest(covers(['usecase:create_task'], 'rejeita título em branco sem salvar ou publicar'), async () => {\n  const { storage, calls, published, ctx, usecase } = setup();\n\n  const error = await usecase.execute({ task_id: 't1', title: ' \\t\\n ' }, ctx).catch(error => error);\n\n  expect(error).toBeInstanceOf(DomainError);\n