{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/usr/bin/zsh -lc 'cat app/domain/task.repository.ts app/infrastructure/in-memory-task.repository.ts app/test/usecase-complete_task.test.ts app/test/entity-Task.test.ts tsconfig.json'","aggregated_output":"import type { Repository } from '@agentic-ddd/core';\nimport type { Task } from './task';\nexport type TaskRepository = Repository<Task, string>;\nimport type { TaskRepository } from '../domain/task.repository';\nimport type { Task } from '../domain/task';\n\nexport class InMemoryTaskRepository implements TaskRepository {\n  readonly #tasks = new Map<string, Task>();\n  async findById(id: string): Promise<Task | null> { return this.#tasks.get(id) ?? null; }\n  async save(task: Task): Promise<void> { this.#tasks.set(task.id, task); }\n}\nimport { expect, test } from 'bun:test';\nimport { DomainError, type DomainEvent, type UseCaseContext } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { CompleteTask } from '../application/complete-task';\nimport { Task } from '../domain/task';\nimport { TaskCompleted } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\nimport { InMemoryTaskRepository } from '../infrastructure/in-memory-task.repository';\n\nfunction setup() {\n  const storage = new InMemoryTaskRepository();\n  const calls: string[] = [];\n  const published: DomainEvent[] = [];\n  const tasks: TaskRepository = {\n    async findById(id) {\n      calls.push(`find:${id}`);\n      return storage.findById(id);\n    },\n    async save(task) {\n      calls.push(`save:${task.id}:${task.status}`);\n      await storage.save(task);\n    },\n  };\n  const ctx: UseCaseContext = {\n    correlationId: 'correlation-1',\n    causationId: 'causation-1',\n    async publish(events) {\n      calls.push('publish');\n      published.push(...events);\n    },\n  };\n  return { storage, calls, published, tasks, ctx, usecase: new CompleteTask(tasks) };\n}\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'carrega t1, salva completed e publica TaskCompleted após salvar'), async () => {\n  const { storage, calls, published, ctx, usecase } = setup();\n  const task = Task.create('t1', 'Minha tarefa');\n  task.pullEvents();\n  await storage.save(task);\n\n  const result = await usecase.execute({ task_id: 't1' }, ctx);\n\n  expect(result).toEqual({ task_id: 't1', status: 'completed' });\n  expect((await storage.findById('t1'))?.status).toBe('completed');\n  expect(calls).toEqual(['find:t1', 'save:t1:completed', 'publish']);\n  expect(published).toHaveLength(1);\n  expect(published[0]).toBeInstanceOf(TaskCompleted);\n  expect(published[0]!.payload).toEqual({ taskId: 't1' });\n  expect(task.pullEvents()).toEqual([]);\n});\n\ntest(covers([\n  'usecase:complete_task',\n  'criterion:0001/persistencia-conclusao',\n], 'rejeita id inexistente com TASK_NOT_FOUND sem salvar ou publicar'), async () => {\n  const { calls, published, ctx, usecase } = setup();\n\n  const error = await usecase.execute({ task_id: 'missing' }, ctx).catch(error => error);\n\n  expect(error).toBeInstanceOf(DomainError);\n  expect(error).toHaveProperty('code', 'TASK_NOT_FOUND');\n  expect(calls).toEqual(['find:missing']);\n  expect(published).toEqual([]);\n});\n\ntest(covers(['usecase:complete_task'], 'rejeita conclusão repetida sem salvar ou publicar novamente'), async () => {\n  const { storage, calls, published, ctx, usecase } = setup();\n  const task = Task.create('t1', 'Minha tarefa');\n  task.pullEvents();\n  await storage.save(task);\n  await usecase.execute({ task_id: 't1' }, ctx);\n  calls.length = 0;\n  published.length = 0;\n\n  const error = await usecase.execute({ task_id: 't1' }, ctx).catch(error => error);\n\n  expect(error).toBeInstanceOf(DomainError);\n  expect(error).toHaveProperty('code', 'TASK_ALREADY_COMPLETED');\n  expect(calls).toEqual(['find:t1']);\n  expect(published).toEqual([]);\n  expect(task.status).toBe('completed');\n  expect(task.pullEvents()).toEqual([]);\n});\n\ntest(covers(['usecase:complete_task'], 'propaga falha de persistência sem publicar eventos'), async () => {\n  const { storage, tasks, calls, published, ctx } = setup();\n  const task = Task.create('t1', 'Minha tarefa');\n  task.pullEvents();\n  await storage.save(task);\n  const failure = new Error('Falha ao salvar');\n  tasks.save = async () => { throw failure; };\n\n  const error = await new CompleteTask(tasks).execute({ task_id: 't1' }, ctx).catch(error => error);\n\n  expect(error).toBe(failure);\n  expect(calls).toEqual(['find:t1']);\n  expect(published).toEqual([]);\n});\nimport { expect, test } from 'bun:test';\nimport { DomainError } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { Task } from '../domain/task';\nimport { TaskCreated } from '../domain/task.events';\n\ntest(covers([\n  'invariant:Task/titulo-obrigatorio',\n  'method:Task.create',\n  'criterion:0001/titulo-invalido',\n], 'rejeita títulos vazios ou compostos apenas por espaços'), () => {\n  for (const title of ['', '   ', '\\t\\n']) {\n    let error: unknown;\n    try {\n      Task.create('t1', title);\n    } catch (caught) {\n      error = caught;\n    }\n    expect(error).toBeInstanceOf(DomainError);\n    expect(error).toHaveProperty('code', 'TASK_TITLE_REQUIRED');\n  }\n});\n\ntest(covers([\n  'method:Task.create',\n  'criterion:0001/criacao',\n], 'cria tarefa pendente com título normalizado e registra TaskCreated'), () => {\n  const task = Task.create('t1', '  Minha tarefa  ');\n\n  expect(task.id).toBe('t1');\n  expect(task.title).toBe('Minha tarefa');\n  expect(task.status).toBe('pending');\n\n  const events = task.pullEvents();\n  expect(events).toHaveLength(1);\n  expect(events[0]).toBeInstanceOf(TaskCreated);\n  expect(events[0]!.payload).toEqual({ taskId: 't1', title: 'Minha tarefa' });\n  expect(task.pullEvents()).toEqual([]);\n});\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"preserve\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"experimentalDecorators\": true,\n    \"emitDecoratorMetadata\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"noEmit\": true,\n    \"types\": [\n      \"bun\"\n    ],\n    \"paths\": {\n      \"@agentic-ddd/*\": [\n        \"/tmp/agentic-eval-KI6lCe/framework/src/*/index.ts\"\n      ],\n      \"zod\": [\n        \"/tmp/agentic-eval-KI6lCe/framework/node_modules/zod\"\n      ]\n    }\n  },\n  \"include\": [\n    \"app/**/*.ts\",\n    \"agentic.config.ts\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
