published[0]?.[0]).toBeInstanceOf(TaskCompleted);\n+  expect((published[0]?.[0] as TaskCompleted).payload).toEqual({ taskId: 't1' });\n+\n+  const act = () => useCase.execute({ task_id: 'missing' }, ctx);\n+  await expect(act()).rejects.toBeInstanceOf(DomainError);\n+  try {\n+    await act();\n+  } catch (error) {\n+    expect(error).toBeInstanceOf(DomainError);\n+    expect((error as DomainError).code).toBe('TASK_NOT_FOUND');\n+    return;\n+  }\n+  throw new Error('expected complete_task to throw');\n+});","afterFullFileContent":"import { expect, test } from 'bun:test';\nimport { DomainError, type UseCaseContext } from '@agentic-ddd/core';\nimport { covers } from '@agentic-ddd/testing';\nimport { CompleteTask } from '../application/complete-task';\nimport { Task } from '../domain/task';\nimport { TaskCompleted } from '../domain/task.events';\nimport type { TaskRepository } from '../domain/task.repository';\n\ntest(covers(['usecase:complete_task', 'criterion:0001/persistencia-conclusao'], 'complete_task salva completed, publica TaskCompleted e falha para id ausente'), async () => {\n  const t1 = Task.create('t1', 'pagar contas');\n  t1.pullEvents();\n  const storage = new Map<string, Task>([['t1', t1]]);\n  const saved: Task[] = [];\n  const published: unknown[][] = [];\n  const repo: TaskRepository = { findById: async (id) => storage.get(id) ?? null, save: async (task) => { saved.push(task); storage.set(task.id, task); } };\n  const ctx: UseCaseContext = { correlationId: 'corr-1', causationId: 'cause-1', publish: async (events) => { published.push([...events]); } };\n  const useCase = new CompleteTask(repo);\n\n  const output = await useCase.execute({ task_id: 't1' }, ctx);\n  expect(output).toEqual({ task_id: 't1', status: 'completed' });\n  expect(saved).toHaveLength(1);\n  expect(saved[0]?.status).toBe('completed');\n  expect(published).toHaveLength(1);\n  expect(published[0]).toHaveLength(1);\n  expect(published[0]?.[0]).toBeInstanceOf(TaskCompleted);\n  expect((published[0]?.[0] as TaskCompleted).payload).toEqual({ taskId: 't1' });\n\n  const act = () => useCase.execute({ task_id: 'missing' }, ctx);\n  await expect(act()).rejects.toBeInstanceOf(DomainError);\n  try {\n    await act();\n  } catch (error) {\n    expect(error).toBeInstanceOf(DomainError);\n    expect((error as DomainError).code).toBe('TASK_NOT_FOUND');\n    return;\n  }\n  throw new Error('expected complete_task to throw');\n});\n","message":"Success. Updated the following files:\nA /tmp/agentic-eval-ZK8DP3/attempt-jdMLVz/workspace/app/test/usecase-complete_task.test.ts"}}},"hookAdditionalContexts":[],"toolCallId":"call_45BqOcreWLGPBKeWSmUncftT\nctc_0a3a3fd95684cb40016aca483f85e487d1ade5e1d47f145fef","startedAtMs":"1791641663556","completedAtMs":"1791641667747"},"model_call_id":"3a35c853-f8bb-46e0-a731-630c325d196a-16-1xmo","session_id":"6a8eecd2-a5b7-47b4-a9ed-bb620a2d038d","timestamp_ms":1791641667280}
