{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": false,
    "types": ["bun"],
    "paths": {
      "@agentic-ddd/core": ["./src/core/index.ts"],
      "@agentic-ddd/decorators": ["./src/decorators/index.ts"],
      "@agentic-ddd/compiler": ["./src/compiler/index.ts"],
      "@agentic-ddd/testing": ["./src/testing/index.ts"],
      "@agentic-ddd/runtime": ["./src/runtime/index.ts"],
      "@agentic-ddd/nestjs": ["./src/nestjs/index.ts"]
    },
    "inlineSources": true,
    "declarationMap": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/__fixtures__/**",
    "src/**/__snapshots__/**"
  ],
  "include": [
    "src/core/**/*.ts",
    "src/decorators/**/*.ts",
    "src/compiler/**/*.ts",
    "src/contracts/**/*.ts",
    "src/runtime/**/*.ts",
    "src/nestjs/**/*.ts",
    "src/testing/**/*.ts",
    "src/cli/**/*.ts"
  ]
}
